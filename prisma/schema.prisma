generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SALES
  QUALITY
  PRODUCTION
  LOGISTICS
}

enum Grade {
  A
  B
}

enum Format {
  WHOLE
  SLICED
  DICED
}

enum PalletStatus {
  IN_STORAGE
  ALLOCATED
  SHIPPED
  WASTE
  DISCOUNT_OFFERED
}

// Most shipments load loose cartons directly into the container (no pallet
// underneath); some clients require the pallet itself to travel. This is a
// per-container (load-out time) choice, not a fixed client/order setting.
enum LoadType {
  PALLETISED
  UNPALLETISED
}

enum QualityCheckpoint {
  PRE_DECAP
  RAW_MATERIAL
  POST_DECAP
  POST_PACKAGING
}

enum ShiftType {
  DAY
  NIGHT
}

enum ComplianceLevel {
  GLOBALGAP
  SPRING
  LEAF
  OTHER
  NURTURE
  AH_DL_GROW
  FAIRTRADE
  ORGANIC_100
  BIO_SUISSE
}

enum MicrobiologyStatus {
  PENDING // not yet sent to the lab
  SENT_TO_LAB // sample dispatched, awaiting result
  APPROVED
  FAILED_MINOR
  FAILED_SEVERE
}

// Every lot gets a sample tested in both -- neither is a substitute for the
// other. A pallet only clears once both come back Approved; if they
// disagree (one Approved, one Failed) the whole shift goes on hold pending
// further testing, since we can't yet tell which lab is right.
enum LabType {
  IN_HOUSE
  EXTERNAL
}

enum OrderStage {
  CONFIRMED
  IN_PRODUCTION
  PACKED
  SHIPPED
  DELIVERED
  PAID
}

enum ClaimReason {
  QUALITY
  PACKAGING
  FOREIGN_MATERIAL
  TRANSPORT
}

enum ClaimSeverity {
  RED
  AMBER
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CREDITED
  CLOSED
}

enum AlertType {
  SPEC_MISMATCH
  CONTAINER_OVERDUE
  LOW_STOCK
  MICROBIOLOGY_PENDING
  MICROBIOLOGY_LOAD_ATTEMPT
  MICROBIOLOGY_REJECTED
  QUALITY_LIMIT_EXCEEDED
  QUALITY_OVERRIDE_APPROVED
  EARLY_WARNING
  SHIFT_ON_HOLD
  TEMPERATURE_EXCURSION
}

enum AlertStatus {
  UNREAD
  READ
}

// A user with a Station set is locked to a single-purpose entry screen (used for
// shop-floor accounts — arrival inspector, post-freeze inspector, load-out supervisor)
// instead of the normal role-wide access. Null means normal, unrestricted access for their role.
enum Station {
  ARRIVAL_INSPECTION
  POST_FREEZE_INSPECTION
  LOAD_OUT
  FINAL_PRODUCT_ENTRY
  LAB
}

enum QualityDecision {
  ACCEPTED
  REJECTED
}

// The call a responsible person makes once a QualityCheck trips a
// QUALITY_LIMIT_EXCEEDED alert -- separate from the inspector's own
// ACCEPTED/REJECTED decision on the form, since this is a second, senior
// review specifically of the out-of-spec reading itself.
enum QualityOverrideStatus {
  PENDING
  REJECTED
  APPROVED_AT_RISK
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  // Historical/trend financials are restricted to Owner + whoever holds this flag,
  // not the whole Sales role — deliberately narrower than order-level pricing access.
  isHeadOfSales      Boolean  @default(false)
  // Only the Owner or whoever holds this flag can sign off loading a pallet that
  // fails a client's own spec (see SpecException) — the accountability the sign-off
  // exists for only holds if the set of people who can grant it is narrow.
  isHeadOfProduction Boolean  @default(false)
  station            Station?
  createdAt          DateTime @default(now())

  qualityChecks            QualityCheck[]
  sentMicrobiologyResults  MicrobiologyResult[] @relation("MicrobiologySentBy")
  uploadedClaimAttachments ClaimAttachment[]    @relation("ClaimAttachmentUploadedBy")
  activityLogs             ActivityLog[]
}

// A generic "who did what, when" trail -- deliberately not tied to one entity
// type, so any action worth being accountable for (a claim status change, a
// quality override, a waste write-off, a user being added or removed) can log
// to the same place instead of each module inventing its own actor field.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  country      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  paymentTerms String?
  incoterms    String?
  currency     String   @default("USD")
  createdAt    DateTime @default(now())

  // Groups sibling entities under one mother company for the historical
  // trends view (e.g. "Chaucer - Linyi"/"Chaucer - Shandong" both set this to
  // "Chaucer"). Null means the client stands alone. A client whose own name
  // equals another client's groupName (e.g. plain "Chaucer") is treated as
  // part of that group too, without needing this field set on itself.
  groupName String?

  specs             ClientSpec[]
  orders            Order[]
  pallets           Pallet[]
  claims            Claim[]
  qualityIssues     QualityIssue[]
  dailyPackingLines DailyPackingLine[]

  @@index([name])
  @@index([groupName])
}

// One row per product-form spec (e.g. "Whole 25-35mm", "Sliced 6-8mm", "Diced 10x10x10mm").
// A client can have any number of these; each can independently exist as Grade A and/or Grade B.
// Defect tolerances are stored as free text because source spec sheets mix units
// (percentages, "3pcs/10kg" counts, "*" for not-applicable, or a note pointing at `notes`).
model ClientSpec {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  specName String // e.g. "Whole 25-35mm", "Sliced 6-8mm", "Standard"
  grade    Grade
  format   Format

  brix        String?
  ph          String?
  sizeCaliber String?

  overripe         String?
  unripe           String?
  calyx            String?
  leaves           String?
  stems            String?
  misshapen        String?
  blemish          String?
  dryPump          String?
  clumps           String?
  broken           String?
  oxidation        String?
  mechanicalDamage String?
  rotten           String?
  insectDamage     String?
  internalQuality  String?
  deadWorm         String?
  fungalInfection  String?
  dryBruises       String?
  foreignBodies    String?

  // The client's own microbiology ceiling -- distinct clients tolerate
  // different cfu/g levels, so a pallet within spec for one client can still
  // be unacceptable for a stricter one (see src/lib/cfuTier.ts).
  maxCfuPerGram Float?

  notes String?

  // See ProductionLot.isTestData -- marks a spec created purely to exercise
  // a feature during development (e.g. "CFU Test Spec"), not a real client
  // requirement.
  isTestData Boolean @default(false)

  @@index([clientId])
}

model Factory {
  id                    String  @id @default(cuid())
  name                  String  @unique
  capacityTonnesPerHour Float
  // The IQF unit code used in lot numbering, e.g. IQF 1 = "11", IQF 2 = "13".
  code                  String?
  // Packing-house accreditation -- produce from an un-coded or unauthorized
  // facility can't legally be exported, so this is the factory's own export
  // eligibility, not paperwork for one particular shipment.
  capqExportCode        String?
  nfsaAccreditationCode String?

  shifts ShiftLog[]
  lots   ProductionLot[]

  dailyTemperatureLogs DailyTemperatureLog[]
  dailyQuantityEntries DailyQuantityEntry[]
  dailyPackingLines    DailyPackingLine[]
  dailyDowntimeEvents  DailyDowntimeEvent[]
  dailyLineEfficiency  DailyLineEfficiency[]
}

// rounds/rackCount/levelCount mirror the real physical storage map exactly
// (كروكى خريطة ثلاجات مصنع التجميد.xlsx): each round is a full rack section
// (racks lettered A, B, C... up to rackCount), each rack has levelCount
// vertical slots. capacityPallets = rounds * rackCount * levelCount.
model ColdRoom {
  id              String  @id @default(cuid())
  name            String  @unique
  capacityPallets Int
  isNew           Boolean @default(false)
  rounds          Int     @default(1)
  rackCount       Int     @default(1)
  levelCount      Int     @default(1)

  pallets Pallet[]
  slots   ColdRoomSlot[]
}

// One row per physical storage position. Generated in full when a cold room
// is created (rounds * rackCount * levelCount rows) so empty slots are just
// as visible as occupied ones -- matching the manual map, which shows the
// whole grid, not just where pallets currently are.
model ColdRoomSlot {
  id         String   @id @default(cuid())
  coldRoomId String
  coldRoom   ColdRoom @relation(fields: [coldRoomId], references: [id])
  round      Int
  rack       String
  level      Int
  palletId   String?  @unique
  pallet     Pallet?  @relation(fields: [palletId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([coldRoomId, round, rack, level])
  @@index([coldRoomId])
}

// Real farm-layout data (Farm/Station/Valve/Variety/boundary geometry) is
// imported from the farm's own GIS system (a GeoPackage export) -- see
// scripts/import-fields.ts. Fields entered by hand (no GIS match) simply
// leave the extra columns null.
model Field {
  id           String  @id @default(cuid())
  name         String  @unique
  mapReference String?

  farmName        String? // e.g. "MAFA 4"
  // Same farm-level accreditation, same code repeated across every field
  // belonging to it -- matches how farmName itself is already denormalized
  // per field row rather than needing a separate Farm entity.
  capqFarmCode    String?
  nfsaFarmCode    String?
  station         String? // irrigation station/block, e.g. "2"
  valve           String? // specific plot within the station, e.g. "1A"
  variety         String? // strawberry variety code, e.g. "MO", "ML52"
  areaFeddans     Float?
  plantingDate    String? // free text -- source mixes years, "Adult", "G2020", "1995&2020"
  avgTonPerFeddan Float? // average of the last few seasons' ton/feddan on file
  googleMapsUrl   String?

  // Polygon boundary in the source GIS's coordinates (UTM Zone 36N, meters),
  // for rendering the schematic field-layout map -- centroid plus one or
  // more rings of [x, y] points. Not a real geo type since this is just for
  // our own map rendering, not spatial queries.
  centroidX Float?
  centroidY Float?
  boundary  Json?

  // Same boundary/centroid reprojected to WGS84 (lat/lng) for plotting on a
  // real basemap (see /fields) -- see scripts/reproject-fields.ts.
  latitude       Float?
  longitude      Float?
  boundaryLatLng Json? // one or more rings of [lat, lng] points

  lots               ProductionLot[]
  qualityChecks      QualityCheck[]
  harvestTicketLines HarvestTicketPlotLine[]
}

enum HarvestProductType {
  RAW
  FINAL
  REWORK
}

// GEN03107 "Product delivery sheet" -- filled out by the field/harvest team
// before a tractor leaves for the decap facility. A single delivery can draw
// from several plots at once, hence the separate line-item table below; the
// receipt section at the bottom is filled in later, by the decap facility,
// once the tractor actually arrives. Pre-Decap Inspection (STR03101) links to
// this via serialNumber (its own "Serial Number (Receipt)" field) to know
// which plot the QC sample was actually drawn from.
model HarvestTicket {
  id           String  @id @default(cuid())
  serialNumber String  @unique
  ggn          String?

  complianceLevel ComplianceLevel?
  complianceOther String?
  productType     HarvestProductType?
  reworkReason    String?

  // Simple pass/fail checklist (left side of the form).
  fruitConformityOk    Boolean?
  fruitSafetyOk        Boolean?
  cratesCleanlinessOk  Boolean?
  fieldCleanlinessOk   Boolean?
  vehicleCleanlinessOk Boolean?

  // Yes/No presence checklist, each with its own corrective action if flagged.
  petsPresent                      Boolean?
  petsPresentAction                String?
  animalProductionNearby           Boolean?
  animalProductionNearbyAction     String?
  wildDomesticAnimalActivity       Boolean?
  wildDomesticAnimalActivityAction String?
  rodentDogActivity                Boolean?
  rodentDogActivityAction          String?

  loadingSupervisor   String?
  loadingTime         DateTime?
  transferredBy       String? // transport method/vehicle description
  vehicleNo           String?
  authorizedGrower    String? // farm name/code
  cropName            String?
  harvestTime         DateTime?
  harvestSupervisor   String?
  harvestDate         DateTime?
  ipmConfirmationDate DateTime? // from IPM03208

  // Packhouse/decap-facility receipt section -- completed on arrival.
  receivedDate           DateTime?
  receivedTime           DateTime?
  deliveryNumber         String?
  cratesReceived         Int?
  palletsReceived        Int?
  grossWeightKg          Float?
  netWeightKg            Float?
  electronicWeightCardNo String?
  productTempC           Float?
  optimumTempC           Float?
  coldTruckTempC         Float?
  acceptedAtPackhouse    Boolean?
  receivedByName         String?

  createdAt DateTime @default(now())

  plotLines HarvestTicketPlotLine[]
}

model HarvestTicketPlotLine {
  id              String        @id @default(cuid())
  harvestTicketId String
  harvestTicket   HarvestTicket @relation(fields: [harvestTicketId], references: [id], onDelete: Cascade)

  stationNo     String?
  plotValveGhNo String?
  fieldId       String?
  field         Field?  @relation(fields: [fieldId], references: [id])

  varietyName  String?
  cycleNumber  String?
  plantingYear String?
  cutNo        String?
  palletsCount Int?
  cratesCount  Int?
  weightKg     Float?

  qualityChecks QualityCheck[]

  @@index([harvestTicketId])
  @@index([fieldId])
}

model ShiftLog {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Factory   @relation(fields: [factoryId], references: [id])
  date        DateTime
  shiftType   ShiftType
  startTime   DateTime
  endTime     DateTime
  workerCount Int
  createdAt   DateTime  @default(now())

  // Set when a lot from this shift gets a split microbiology result (one lab
  // approves, the other fails) -- every lot from the same shift is held
  // until further testing resolves the disagreement, since the contamination
  // risk isn't known to be specific to just the one sampled lot.
  onHold             Boolean   @default(false)
  holdReason         String?
  holdSince          DateTime?
  holdResolvedAt     DateTime?
  holdResolvedBy     String?
  holdResolutionNote String?

  // Costing -- entered after the fact (end of day/week), not at shift-creation
  // time, so both are nullable. laborHourlyRateEgpSnapshot is the wage rate in
  // effect when this shift's costing was confirmed (defaults from
  // CompanySettings.laborHourlyRateEgp but stored per-shift so a later rate
  // change doesn't retroactively alter this shift's already-computed margin).
  rawMaterialCostEgp         Float?
  laborHourlyRateEgpSnapshot Float?

  lots  ProductionLot[]
  waste Waste[]

  @@index([factoryId, date])
}

// Company-wide costing rates -- a singleton row (find-or-create on first
// access), not per-factory, since FX and wages are set at the company level.
model CompanySettings {
  id                 String @id @default(cuid())
  fxRateEgpPerUsd    Float?
  laborHourlyRateEgp Float?
}

// lotNumber is auto-generated: {farmCode}{factory.code}{YY}{DDD}-{shift digit}
// e.g. M41126146-1 = farm M4, IQF 1 (code 11), 2026, day 146 (26 May), shift 1 (day).
model ProductionLot {
  id               String   @id @default(cuid())
  lotNumber        String   @unique
  farmCode         String
  shiftId          String
  shift            ShiftLog @relation(fields: [shiftId], references: [id])
  factoryId        String
  factory          Factory  @relation(fields: [factoryId], references: [id])
  fieldId          String
  field            Field    @relation(fields: [fieldId], references: [id])
  grade            Grade
  format           Format
  isEndOfDayGradeB Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Marks a lot created purely to exercise a feature during development
  // (e.g. lotNumber "TEST1126210-1") -- surfaced as a visible warning
  // wherever the lot is shown so it's never mistaken for real production.
  isTestData Boolean @default(false)

  pallets             Pallet[]
  qualityChecks       QualityCheck[]
  microbiologyResults MicrobiologyResult[]
  qualityIssues       QualityIssue[]

  @@index([factoryId, grade])
}

// cartonLogo/cartonSize/variety are physical carton attributes fixed at packing.
// packing*/palletization* fields mirror form GEN03115 "Identification of Packed
// Pallets" — filled out by the Final Product Entry role as each pallet is wrapped,
// which is what actually creates most Pallet rows (a lot can also still be bulk
// pallet-generated at production time as a quicker fallback — see createLotAction).
// loadingStart/loadingEnd (on ContainerPalletLine) are a separate, later moment:
// when the pallet is loaded into a container for shipment.
// The physical pallet base itself is a durable, reusable asset with its own
// branded number -- it isn't created per lot, and the same number legitimately
// comes back under a different lot once its previous cargo has shipped and it
// re-enters rotation. So palletNumber alone is never unique; what's actually
// unique is "this physical pallet, on this particular production run".
model Pallet {
  id           String        @id @default(cuid())
  palletNumber String
  lotId        String
  lot          ProductionLot @relation(fields: [lotId], references: [id])
  coldRoomId   String?
  coldRoom     ColdRoom?     @relation(fields: [coldRoomId], references: [id])
  weightTonnes Float         @default(1.2)
  status       PalletStatus  @default(IN_STORAGE)
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  createdAt    DateTime      @default(now())

  cartonLogo String?
  cartonSize String?
  variety    String?

  // GEN03115 fields
  clientSpecNote     String? // اسم العميل — intended client, may be set before a formal Order exists
  qualityGrade       Grade? // standalone from client — defaults to the lot's grade but overridable per pallet at pack time
  isMixedVariety     Boolean   @default(false)
  fullPallet         Boolean   @default(true)
  totalCartons       Int?
  packingDate        DateTime?
  packingLocation    String?
  packingSupervisor  String?
  // Carton + liner cost for this pallet -- a direct cost entered at packing
  // time, not allocated like raw material/labor.
  packagingCostUsd   Float?
  palletizationStart DateTime?
  palletizationEnd   DateTime?

  // Whether this pallet's fruit is calibrated or uncalibrated -- a single
  // packer classification at packing time, not a re-entry of the detailed
  // size-band measurements already captured at Post-Freeze Inspection
  // (QualityCheck.fruitDiameterCalibratedSmall/Medium/Large). Null = not yet
  // set.
  fruitDiameterCalibrated Boolean?

  // Cartons packed without a confirmed client/sale go out blank and need a
  // client sticker applied at the load-out bay before they can go in the container.
  stickeringRequired    Boolean   @default(false)
  stickeringCompletedAt DateTime?

  // See ProductionLot.isTestData -- same purpose, tracked per-pallet too
  // since a pallet created for testing can be re-palletized under a later,
  // genuinely real lot.
  isTestData Boolean @default(false)

  waste          Waste[]
  qualityChecks  QualityCheck[]
  loadLines      ContainerPalletLine[]
  slot           ColdRoomSlot?
  specExceptions SpecException[]

  @@unique([palletNumber, lotId])
  @@index([palletNumber])
  @@index([status])
  @@index([coldRoomId])
}

// Mirrors the real inspection forms:
// - PRE_DECAP:       STR03101 "Packhouse intake quality assessment: Strawberry for decapping"
//                     (fruit arriving at the decap facility from the field)
// - POST_DECAP:      STR03107 "Final product strawberry inspection: decapping"
//                     (greenlight for fruit to leave the decap facility for the factory)
// - RAW_MATERIAL:    STR03110 "Inspection of Prepared Strawberries Upon Receipt"
// - POST_PACKAGING:  STR03111 / STR03116 "Inspection of Frozen Strawberries at End of Line" (Grade A / B)
// Fields not relevant to a given checkpoint are simply left null.
model QualityCheck {
  id                      String                 @id @default(cuid())
  // Nullable: raw-material checks happen at the receiving dock before a
  // production lot exists, so they're logged standalone. Post-packaging
  // checks are still tied to the lot they came from (enforced in the action).
  lotId                   String?
  lot                     ProductionLot?         @relation(fields: [lotId], references: [id])
  palletId                String?
  pallet                  Pallet?                @relation(fields: [palletId], references: [id])
  // The specific field plot this batch came from, for checks that can be
  // tied to one field (Pre-Decap Inspection and Post-Decap Quality). A single
  // delivery can carry fruit from multiple fields per the harvest ticket, so
  // this is a one-field-at-a-time link, not the full per-field crate breakdown.
  fieldId                 String?
  field                   Field?                 @relation(fields: [fieldId], references: [id])
  // Pre-Decap Inspection links here directly, by Harvest Ticket Serial Number,
  // to record exactly which plot line the sample was drawn from -- independent
  // of whether that plot line's station/valve happened to resolve to a Field
  // record (fieldId above), since real harvest tickets don't always match.
  harvestTicketPlotLineId String?
  harvestTicketPlotLine   HarvestTicketPlotLine? @relation(fields: [harvestTicketPlotLineId], references: [id])
  checkpoint              QualityCheckpoint

  // Both checkpoints end in an Acceptable/Unacceptable call + corrective action
  // (the "notes" field below). appliesToWholeDelivery is RAW_MATERIAL only: a
  // supervisor can reject an entire truckload outright without inspecting every pallet on it.
  decision               QualityDecision?
  appliesToWholeDelivery Boolean          @default(false)

  complianceLevel ComplianceLevel?
  complianceOther String?
  shiftNumber     String?

  // Shared measurements
  brix                 Float
  fruitColorPct        Float?
  internalQualityPct   Float?
  acidityPh            Float?
  productTemperatureC  Float?
  varietyName          String?
  sampleCollectionTime DateTime?
  sampleWeightKg       Float?

  // Defect items shared across STR03107, STR03110, and STR03111/STR03116 (same
  // % unit, different limit per form — the limit is enforced in the UI, not the DB).
  incompleteMaturityPct Float?
  shapeDeformitiesPct   Float?
  oxidationPct          Float?
  foreignBodiesPct      Float?
  insectsLarvaePct      Float?
  totalDefectsPct       Float?
  foreignOdor           String?
  foreignTaste          String?
  overmaturePct         Float?

  // STR03110 — raw material intake only (Arrival Inspection at Factory)
  sampleNo                String?
  rawMaterialSource       String?
  farmCode                String?
  decapPackHouse          String? // which decapping pack house this delivery is arriving from
  decapQcApprover         String? // the QC number (QC1-QC51) who approved it to leave the decap facility -- required on Post-Decap Quality itself, optionally echoed here
  transportVehicleNo      String?
  receiptNoteNo           String?
  numberOfBoxesReceived   Int?
  crateWeightKg           Float?
  sizeCaliber             String?
  moldSignsPct            Float? // بوادر عفن — distinct from Mold itself (mouldPct)
  capsuleRemainsPct       Float? // بقايا الكبسولة (STR03110 measures this as a %)
  birdFoodPct             Float? // اكل طيور
  seedClusteringPct       Float? // تجمع البذور
  bruisesPct              Float? // كدمات
  dryCavitiesPct          Float? // تجاويف جافة
  overDecappingPct        Float? // تجهير جائر
  sandDustPct             Float? // تربة/رمال
  leafStemRemainsCount    Float? // بقايا اوراق / سيقان — limit is 1 piece/1kg
  brokenUncleanPalletsPct Float? // باليتات مكسورة او غير نظيفة
  unfumigatedPalletsPct   Float? // باليتات غير مبخرة
  brokenUncleanCratesPct  Float? // اطباق مكسورة او غير نظيفة

  // Post-Decap Quality only (STR03107) -- checked right after decapping, the
  // greenlight for fruit to proceed from the decap facility to the factory.
  // Its defect checklist is otherwise identical to STR03110's (reused above).
  processingLine      String? // رقم السير
  divertedTo          String? // تم تحويل الشحنة الى -- where a nonconforming shipment was diverted (e.g. local market)
  retrainingRequested Boolean? // اعادة تدريب مجموعة التجهيز -- packing group re-training requested

  // Pre-Decap Inspection only (STR03101) -- fruit arriving at the decap
  // facility from the field, before decapping. Cleaning/crates is a pass/fail
  // check, not a percentage, hence the boolean. harvestSupervisor is not on
  // the paper form itself but is who STR03101's own instructions say to
  // notify (via GEN03108) if the delivery has defects.
  harvestSupervisor    String?
  cleaningGoodCratesOk Boolean? // نظافه وسلامه الصناديق
  diameterUnder22mmPct Float? // قطر اقل من 22مم
  botrytisPct          Float? // عفن ثمار (Botrytis specifically, distinct from mouldPct)
  earlyBotrytisPct     Float? // بوادر عفن ثمار مبكرة -- early-warning signs, tighter limit than full Botrytis -- limit ≤1%
  pestDiseasePct       Float? // حشرات / امراض
  insectDamagePct      Float? // ضرر حشري -- limit ≤5%
  wormEatenPct         Float? // اكل دود
  birdTracesPct        Float? // آثار طيور -- limit ≤5%
  leavesStalksPct      Float? // اوراق او سيقان -- limit ≤5%

  // STR03111 / STR03116 — post-packaging only
  clientName                    String?
  operationDate                 DateTime?
  expiryDate                    DateTime?
  fullPallet                    Boolean?
  cartonWeightKg                Float?
  packageClosureOk              Boolean?
  dataLabelReviewOk             Boolean?
  fruitDiameterUncalibrated     String?
  fruitDiameterCalibratedSmall  String?
  fruitDiameterCalibratedMedium String?
  fruitDiameterCalibratedLarge  String?
  capsuleRemainsCount           Float? // بقايا الكبسولة — measured as pieces/10kg here, distinct unit from raw's capsuleRemainsPct
  leafRemainsCount              Float? // رض الاوراق وبقايا اوراق — pieces/10kg
  stemFragmentsCount            Float? // السيقان وشظايا الساق — pieces/10kg
  cohesiveClustersPct           Float? // كتل متماسكة (2:3 قطع)
  crushedBrokenFruitPct         Float? // ثمار محطمة/مكسورة
  dryBruisesPct                 Float? // خبطات جافة
  mechanicalFactorsPct          Float? // عوامل ميكانيكية
  fungalInfectionPct            Float? // اصابة فطرية
  insectInfestationPct          Float? // اصابة حشرية (distinct from insectsLarvaePct)
  frozenProductWaitMinutes      Float? // فترة انتظار المنتج المجمد

  // Legacy/general defect fields
  mouldPct      Float?
  skinDamagePct Float?
  firmnessScore Float?

  notes String?

  // Set only when this check trips a QUALITY_LIMIT_EXCEEDED alert -- the
  // responsible person's call on whether to reject outright or sign off to
  // proceed at their own risk, made from the Alerts page.
  overrideStatus    QualityOverrideStatus?
  overrideByName    String?
  overrideSignature String?
  overrideNote      String?
  overrideAt        DateTime?

  inspectorId String?
  inspector   User?    @relation(fields: [inspectorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([lotId, checkpoint])
  @@index([palletId])
}

// A sample from every lot/shift is tested in BOTH our in-house lab and an
// external lab -- one row per (lot, labType), never a substitute for each
// other. See raiseShiftOnHoldAlert in src/lib/alerts.ts for what happens
// when the two disagree.
model MicrobiologyResult {
  id           String             @id @default(cuid())
  lotId        String
  lot          ProductionLot      @relation(fields: [lotId], references: [id])
  labType      LabType
  status       MicrobiologyStatus @default(PENDING)
  receivedDate DateTime?
  notes        String?

  // Dispatch — when the sample was actually sent out to the lab, tracked
  // separately from the result so the lab rep can see what's in flight.
  // Not applicable to the in-house lab, which tests on-site.
  sentDate     DateTime?
  sentByUserId String?
  sentBy       User?     @relation("MicrobiologySentBy", fields: [sentByUserId], references: [id])
  trackingRef  String?

  // Shared by both lab types -- both real certificates on file (in-house's
  // QR MIC 13/100, and external lab "Healthy Labs" Test Certificate) turned
  // out to have essentially the same shape: a client/sample header, a
  // repeatable tests table, and a reviewed/approved sign-off.
  certificateNumber String? // in-house "Certificate No."; external "Certificate Code" e.g. "MGF 0622\26"
  labName           String? // e.g. "Healthy Labs — Healthy Laboratories for Food and Water Testing"
  clientName        String? // "Client" -- the requesting entity, not a sales client
  clientAddress     String?
  attentionTo       String? // external cert's "Attention" -- the contact person at Magrabi, e.g. "Eng. Adel Elzalabany"
  sampleCode        String? // in-house "Sample Code"; external "Sample Code" (distinct code from our own lotNumber)
  sampleType        String? // e.g. "Strawberry Frozen, Lot: M 41126059-1, Reduplicate: 1/3, Sample Date: 06/05/2026"
  sampleSize        String? // e.g. "1 kg"
  sampleCondition   String? // e.g. "Kept frozen"
  sampleData        String? // in-house "Data of Sample" (بيانات العينة)
  otherData         String? // in-house "Other Data" (بيانات آخري)
  reportDate        DateTime?
  recommendation    String? // in-house only -- external cert has no equivalent line
  preparedBy        String? // in-house only -- "Documents Section"; external cert has no equivalent
  reviewedBy        String? // in-house "Head Section Lab"; external e.g. "Quality Manager"
  approvedBy        String? // in-house "Labs Director"; external e.g. "Lab Manager"
  analysisStartDate DateTime? // in-house "Analysis Date"; external "Testing Date"
  analysisEndDate   DateTime? // in-house "Analysis ended in"; external certs are usually same-day, leave blank
  personInCharge    String?
  resultsSummary    String? // free text catch-all; testLines below is the structured form

  // A dedicated structured field for this one specific test (Total/Aerobic
  // Plate Count), distinct from the free-text testLines table below -- this
  // is the only test result the app needs to parse into a number (for the
  // cfu/g tier system), so it gets its own numeric column rather than trying
  // to parse it back out of testLines[].result, which stays free text since
  // a reading there can be a count, "<10", or "Not Detected".
  totalPlateCountCfuG Float?

  testLines MicrobiologyTestLine[]

  // Older external residue/contaminant certificates (e.g. chlorates &
  // perchlorates panels) that don't fit the shared shape above -- kept for
  // that case, left blank for both in-house and the standard external
  // microbiology certificate.
  sampleId          String? // e.g. "Dokki-2026-170105"
  protocolNumber    String? // e.g. "MAFA 04- IQF UNIT (11) LOT-M41126146-1" — the lab's own reference, distinct from our lotNumber
  samplingBagSerial String? // the certificate's own "Lot Number" field is actually this, not our lot number — kept distinct to avoid confusion
  samplingPlace     String? // e.g. "M4 FARM" — free text, not forced to match a Field record exactly
  methodName        String? // e.g. "Chlorates & Perchlorates" -- single-panel certs only; the standard case uses testLines above

  // The certificate file itself, stored on local disk outside public/ and
  // only ever served through an authenticated route — see src/lib/files.ts.
  certificateFileName         String? // generated on-disk filename
  certificateFileOriginalName String? // original filename, for display

  // Rejection detail — only meaningful when status is FAILED_MINOR/FAILED_SEVERE.
  rejectedQuantityTonnes Float? // volume that did not make spec
  rejectionReason        String? // why it failed
  correctiveAction       String? // what was done about it

  // See ProductionLot.isTestData -- marks a result fabricated purely to
  // exercise a feature during development, not a genuine lab certificate.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([lotId, labType])
}

// The repeatable "Tests" table shared by both certificates -- e.g. "Aerobic
// total plate count 30°C" / "3000 cfu/g" / "ISO 4833 2013" (in-house adds a
// separate `unit` column; external expresses measurement uncertainty (MU)
// instead, e.g. "± 0.015"). `result` is free text since a reading can be a
// count, "<10", or "Not Detected".
model MicrobiologyTestLine {
  id                   String             @id @default(cuid())
  microbiologyResultId String
  microbiologyResult   MicrobiologyResult @relation(fields: [microbiologyResultId], references: [id], onDelete: Cascade)

  testName               String?
  result                 String?
  unit                   String?
  measurementUncertainty String? // external cert's "MU" column, e.g. "± 0.015"
  methodRef              String?

  @@index([microbiologyResultId])
}

model Waste {
  id       String    @id @default(cuid())
  // Exactly one of these is set, depending on where the waste happened.
  // Finished pallets that spoil/fail in storage link to the pallet directly.
  // Raw fruit rejected off the inspection belt (before any lot/pallet exists)
  // never gets weighed piece-by-piece -- it's gathered and weighed once at
  // the end of the shift, so it links to the shift as a whole instead.
  palletId String?
  pallet   Pallet?   @relation(fields: [palletId], references: [id])
  shiftId  String?
  shift    ShiftLog? @relation(fields: [shiftId], references: [id])
  quantity Float
  reason   String
  date     DateTime  @default(now())
  // Entered manually by whoever marks the write-off -- simpler and more
  // reliable than trying to auto-derive it from upstream raw-material/labor
  // cost, which would require tracing back through the shift/lot chain.
  valueUsd Float?
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     String     @unique // our own internal reference, auto-generated
  poNumber        String? // the client's own purchase-order number, optional -- may not exist or arrive later
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id])
  grade           Grade
  format          Format
  quantityPallets Int
  valueUsd        Float
  stage           OrderStage @default(CONFIRMED)
  orderDate       DateTime
  shipDate        DateTime?
  isHistorical    Boolean    @default(false)
  createdAt       DateTime   @default(now())

  pallets       Pallet[]
  containers    Container[]
  qualityIssues QualityIssue[]

  @@index([clientId])
}

// A container holds ~25t loose-packed or ~24t palletised; since a pallet is
// 1.2t, that rarely divides evenly. Large orders span multiple containers,
// and the pallet that's mid-way through when a container fills up gets its
// remaining cartons carried into the next container (see ContainerPalletLine).
model Container {
  id                             String    @id @default(cuid())
  orderId                        String
  order                          Order     @relation(fields: [orderId], references: [id])
  containerNumber                String    @unique
  carrier                        String?
  departurePort                  String?
  destinationPort                String?
  // A port name alone doesn't make the country obvious, and doesn't say
  // whether the port itself is the end of the line or just where this
  // container transships onward (by another vessel, or overland) to reach
  // its actual final country -- this makes that explicit instead of
  // implied by the port name.
  destinationCountry             String?
  departureDate                  DateTime?
  expectedTransitDays            Int?
  currentLocation                String?
  trackingProvider               String?
  trackingRef                    String?
  // The tamper-evident seal locked on after loading, and the shipping
  // line's own bill of lading number -- both are what a client, customs
  // broker, or bank (for L/C terms) actually reference for this specific
  // shipment, and what proves the container wasn't opened in transit.
  sealNumber                     String?
  billOfLadingNumber             String?
  // Which vessel/voyage this container is actually on, and the carrier's own
  // booking reference -- booking usually exists before the container number
  // is even assigned, and vessel/voyage is what a tracking-provider
  // integration would key off once one's wired up.
  vesselName                     String?
  voyageNumber                   String?
  bookingNumber                  String?
  // Export paperwork, separate from the factory's own Certificate of
  // Quality -- these are what customs and the client's own import broker
  // actually ask for. Mirrors Egypt's real fresh-produce export clearance
  // chain: a Nafeza inspection request triggers CAPQ/NFSA to inspect and
  // seal the reefer on-site under the "Bolsa" permit, samples get tested
  // for the NFSA health certificate, and the shipment gets its customs
  // declaration filed on Nafeza. Phytosanitary and fumigation certificates
  // are situational, not universal -- fumigation only applies to wooden
  // packaging (ISPM 15) and phytosanitary requirements vary by crop and
  // destination market, so neither is required on every shipment.
  nafezaInspectionRequestRef     String?
  bolsaPermitNumber              String?
  phytosanitaryCertNumber        String?
  nfsaHealthCertNumber           String?
  fumigationCertNumber           String?
  certificateOfOriginNumber      String?
  customsExportDeclarationNumber String?
  // The reefer's target temperature for this shipment (IQF frozen product is
  // normally -18°C) -- readings during transit get compared against this to
  // catch an excursion, not stored as their own pass/fail flag, so a
  // corrected set-point doesn't retroactively change what counted as a
  // problem at the time.
  reeferSetPointC                Float?
  createdAt                      DateTime  @default(now())

  // Load-out manifest header (GEN03115): captured when pallets are loaded for shipment.
  loadingDate       DateTime?
  loadingLocation   String?
  loadingSupervisor String?
  loadType          LoadType?

  // Sign-off once loading is complete: one rep from the load-out team, one from quality.
  loadOutRepName  String?
  loadOutSignedAt DateTime?
  qualityRepName  String?
  qualitySignedAt DateTime?

  // The Certificate of Quality is gated on (lab clearance approved for every
  // lot in this container + both sign-offs above) and, once explicitly
  // approved, frozen as a permanent snapshot so later data edits (a quality
  // check correction, a lab re-classification) can't retroactively change
  // what was actually certified at the time of shipment.
  certificateApprovedAt     DateTime?
  certificateApprovedByName String?
  certificateSnapshot       Json?

  // Order.valueUsd is one lump sum for the whole order, which can span
  // several containers -- these let a specific container's own value be
  // computed exactly (by weight or by carton count) once its rate is known,
  // independent of however the rest of the order is priced.
  pricePerKgUsd     Float?
  pricePerCartonUsd Float?

  claimLines      ClaimContainerLine[]
  palletLines     ContainerPalletLine[]
  costs           ContainerCost[]
  temperatureLogs ContainerTemperatureLog[]
  specExceptions  SpecException[]
  qualityIssues   QualityIssue[]
}

// A named, signed record of a deliberate decision to load a pallet that fails
// one of the destination client's own spec parameters (see
// src/lib/specCompliance.ts) -- one row per (pallet, container, parameter),
// since a single pallet can be signed off on more than one violated
// parameter at once, and the same reading can pass one client's spec while
// failing a stricter one, so this can't be a single flag on the QualityCheck
// itself. Only ever created by overrideSpecExceptionAction, gated to the
// Owner or whoever holds User.isHeadOfProduction -- the whole point is a
// permanent, named trail the owner can hold that person accountable against.
model SpecException {
  id          String    @id @default(cuid())
  palletId    String
  pallet      Pallet    @relation(fields: [palletId], references: [id])
  containerId String
  container   Container @relation(fields: [containerId], references: [id])

  parameter      String // ClientSpec field key, e.g. "calyx", "brix"
  parameterLabel String // human label for display, e.g. "Calyx"
  measuredValue  String // formatted reading at time of override, e.g. "3.2 pcs/10kg"
  specLimit      String // the client's raw spec text, e.g. "2pcs/10kg"

  approvedByName    String
  approvedSignature String
  note              String?
  createdAt         DateTime @default(now())

  @@index([palletId, containerId])
}

// One row per reading taken during transit -- there's no fixed schedule (a
// forwarder might report every few hours, or only at port calls), so this is
// a log, not a handful of fixed checkpoint fields.
model ContainerTemperatureLog {
  id           String    @id @default(cuid())
  containerId  String
  container    Container @relation(fields: [containerId], references: [id])
  recordedAt   DateTime  @default(now())
  temperatureC Float
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([containerId])
}

enum ContainerCostCategory {
  DEMURRAGE
  DETENTION
  STORAGE
  CUSTOMS_DELAY
  DOCUMENTATION
  INSPECTION
  REROUTING
  OTHER
}

// Any cost beyond the base freight/booking rate -- demurrage, detention,
// storage, a customs hold, an unplanned reroute. Its own table (not a single
// field) because a shipment can rack up more than one of these over its
// transit, each on its own date, and each needs its own reason on record.
model ContainerCost {
  id          String                @id @default(cuid())
  containerId String
  container   Container             @relation(fields: [containerId], references: [id])
  category    ContainerCostCategory
  amountUsd   Float
  description String?
  incurredAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())

  @@index([containerId])
}

// How much of a given pallet's tonnage went into a given container. Normally
// a pallet appears in exactly one line at its full weight; when a container
// fills up mid-pallet, that pallet gets a second line in the next container
// for its remaining tonnage.
model ContainerPalletLine {
  id             String    @id @default(cuid())
  containerId    String
  container      Container @relation(fields: [containerId], references: [id])
  palletId       String
  pallet         Pallet    @relation(fields: [palletId], references: [id])
  quantityTonnes Float
  // Start/end of physically loading this pallet's cartons — frozen product
  // sitting in the loading bay loses temperature, so this measures how long
  // that took, not just a single "done" timestamp.
  loadingStart   DateTime?
  loadingEnd     DateTime?
  createdAt      DateTime  @default(now())

  @@index([containerId])
  @@index([palletId])
}

// Mirrors form CH08403 "Client Claim Form". One claim can span multiple
// containers (see ClaimContainerLine) — the form has a repeating per-container
// table under a single claim header.
model Claim {
  id          String        @id @default(cuid())
  claimNumber String?
  claimDate   DateTime      @default(now())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  variety     String?
  reason      ClaimReason
  severity    ClaimSeverity
  valueUsd    Float
  status      ClaimStatus   @default(OPEN)

  // Weight deduction (if claim involves a weight discrepancy)
  weightMagrabiTon    Float?
  weightClientTon     Float?
  weightDifferenceKg  Float?
  weightDifferencePct Float?

  // Pricing / contract context
  clientPrice               Float?
  shippingPricePerContainer Float?
  clientFarmGateBeforeIssue Float?
  clientFarmGateAfterIssue  Float?
  totalShippingPrice        Float?
  priceAgreement            String?
  paymentTerms              String?
  contractWithCompany       String?

  claimDetails    String?
  qualityResponse String?

  // Third-party container inspection
  inspectionCompanySent   Boolean?
  inspectionCompanyName   String?
  inspectionCompanyCost   Float?
  inspectionCompanyReport String?

  // Financial negotiation trail
  amountRequestedFromClient  Float?
  amountAfterNegotiation     Float?
  discountValue              Float?
  amountRequestedForApproval Float?
  totalShipmentValue         Float?
  discountPct                Float?

  otherNotes String?

  // Approval sign-offs
  accountManager     String?
  itManager          String?
  exportManager      String?
  exportDirector     String?
  commercialDirector String?
  chairman           String?

  resolvedDate DateTime?
  createdAt    DateTime  @default(now())

  containers  ClaimContainerLine[]
  attachments ClaimAttachment[]

  @@index([clientId])
}

// Photo/document evidence attached to a claim -- who uploaded each file is
// recorded so the trail of who supplied what evidence is traceable later.
model ClaimAttachment {
  id               String   @id @default(cuid())
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  caption          String?
  uploadedByUserId String?
  uploadedBy       User?    @relation("ClaimAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([claimId])
}

// One row per container listed in the claim's per-container table.
model ClaimContainerLine {
  id                    String     @id @default(cuid())
  claimId               String
  claim                 Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  containerNumber       String
  containerId           String?
  container             Container? @relation(fields: [containerId], references: [id])
  variety               String?
  shippingLine          String?
  cartonsPerContainer   Int?
  netWeight             Float?
  shipmentDate          DateTime?
  arrivalDate           DateTime?
  complaintDate         DateTime?
  sellingPricePerCarton Float?
  shippingPrice         Float?
  lostCartons           Int?
  creditRequired        Float?
  claimPct              Float?
  claimAmount           Float?
  totalSales            Float?

  @@index([claimId])
  @@index([containerId])
}

enum QualityIssueStatus {
  OPEN
  RESOLVED
}

// A quality problem reported (often by a client) without a financial claim
// attached -- the goal is process improvement, not compensation. Reuses
// ClaimReason since the categories (quality/packaging/foreign material/
// transport) are the same either way.
model QualityIssue {
  id               String             @id @default(cuid())
  issueDate        DateTime           @default(now())
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id])
  variety          String?
  reason           ClaimReason
  status           QualityIssueStatus @default(OPEN)
  // Order #, container #, or lot # this relates to, if known -- kept as raw
  // text since it may reference any of several entity types, but resolved at
  // creation time against whichever table's number matches (at most one of
  // the three below, since order/container/lot numbers don't overlap) so a
  // typo is visible rather than silently unlinked.
  relatedReference   String?
  relatedOrderId     String?
  relatedOrder       Order?         @relation(fields: [relatedOrderId], references: [id])
  relatedContainerId String?
  relatedContainer   Container?     @relation(fields: [relatedContainerId], references: [id])
  relatedLotId       String?
  relatedLot         ProductionLot? @relation(fields: [relatedLotId], references: [id])

  issueDetails     String?
  correctiveAction String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([relatedOrderId])
  @@index([relatedContainerId])
  @@index([relatedLotId])
}

model Alert {
  id                String      @id @default(cuid())
  type              AlertType
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  targetRole        Role
  status            AlertStatus @default(UNREAD)
  createdAt         DateTime    @default(now())

  @@index([targetRole, status])
}

// Digitizes the factory's existing 4-part paper/Excel "Frozen Strawberry
// Production Report" (one filed per day). Every figure here is manually
// transcribed from the real form, not derived from other app data -- the
// relationships between stages (first balance, raw incoming, rejects, etc.)
// aren't reliably computable, and this report is itself the factory's own
// manual daily reconciliation.

// Hourly instrument reading -- append-only, one row per entry, mirroring
// ContainerTemperatureLog exactly. `location` is matched in code (not the DB)
// against a fixed list carrying each location's Limits/Instrument reference,
// since that's fixed metadata, not something that varies per reading.
model DailyTemperatureLog {
  id         String   @id @default(cuid())
  factoryId  String
  factory    Factory  @relation(fields: [factoryId], references: [id])
  location   String
  recordedAt DateTime @default(now())
  valueC     Float
  notes      String?
  createdAt  DateTime @default(now())

  @@index([factoryId, location, recordedAt])
}

// Section I) Quantities -- one row per plant/shift/variety/day. Both the
// tonnage and % columns are transcribed as entered on the paper form.
model DailyQuantityEntry {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType
  variety   String

  firstBalanceTon Float?

  rawIncomingTon Float?
  rawIncomingPct Float?

  inletForOperationTon Float?
  inletForOperationPct Float?

  endBalanceTon Float?
  endBalancePct Float?

  firstClassWholeTon Float?
  firstClassWholePct Float?

  secondClassWholeTon Float?
  secondClassWholePct Float?

  rejectedBeforeTunnelTon Float?
  rejectedBeforeTunnelPct Float?

  rejectedAfterTunnelTon Float?
  rejectedAfterTunnelPct Float?

  totalPackedTon Float?
  totalPackedPct Float?

  // "الفاقد والمتمم الحسابي" -- lost / reconciliation difference, distinct
  // from both rejection categories. Verified against the real report: Total
  // Packed + Rejected(before) + Rejected(after) + Lost == Inlet for Operation.
  lostTon Float?
  lostPct Float?

  createdAt DateTime @default(now())

  @@index([factoryId, date])
}

// Section II) Packing -- one row per package line. clientOther covers rows
// that aren't a real sales client (e.g. lab/quality samples), matching the
// SelectWithOther dropdown-with-free-text-fallback pattern used elsewhere.
model DailyPackingLine {
  id        String   @id @default(cuid())
  date      DateTime
  factoryId String?
  factory   Factory? @relation(fields: [factoryId], references: [id])

  packageType String
  logo        String
  weightKg    Float?
  variety     String?

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  clientOther String?

  firstClassQty   Int?
  secondClassQty  Int?
  totalPackageQty Int?
  totalTon        Float?

  createdAt DateTime @default(now())

  @@index([date])
}

// Section IV) Downtime -- one row per stoppage event, per plant/shift/day.
model DailyDowntimeEvent {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType
  reason    String
  fromTime  DateTime
  toTime    DateTime

  createdAt DateTime @default(now())

  @@index([factoryId, date])
}

// Sections III/V) Line Power & Actual Line Efficiency summary -- one row per
// plant/shift/day. Total Downtime and Actual Run Time are computed on
// display from this row's uptime window plus the linked DailyDowntimeEvent
// rows, not stored here.
model DailyLineEfficiency {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType

  uptimeFrom             DateTime?
  uptimeTo               DateTime?
  lineCapacityTonPerHour Float?
  expectedQuantityTon    Float?
  actualQuantityTon      Float?

  createdAt DateTime @default(now())

  @@unique([factoryId, date, shiftType])
}

// Decap has no dedicated Factory/ShiftLog entity of its own (it exists only
// implicitly via the PRE_DECAP/POST_DECAP QualityCheckpoint values), so this
// is a plain one-row-per-day log rather than something tied to a factory or
// shift. Weight In is deliberately NOT stored here -- it's always computed
// live from HarvestTicket.netWeightKg (already captured at the decap receipt
// step), so there's no second copy of that number to drift out of sync.
model DecapDailyLog {
  id          String   @id @default(cuid())
  date        DateTime @unique
  weightOutKg Float?
  calyxKg     Float?
  createdAt   DateTime @default(now())
}
