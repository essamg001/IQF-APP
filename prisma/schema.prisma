generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SALES
  QUALITY
  PRODUCTION
  LOGISTICS
}

enum Grade {
  A
  B
}

enum Format {
  WHOLE
  SLICED
  DICED
}

enum PalletStatus {
  IN_STORAGE
  ALLOCATED
  SHIPPED
  WASTE
  DISCOUNT_OFFERED
}

// Most shipments load loose cartons directly into the container (no pallet
// underneath); some clients require the pallet itself to travel. This is a
// per-container (load-out time) choice, not a fixed client/order setting.
enum LoadType {
  PALLETISED
  UNPALLETISED
}

enum QualityCheckpoint {
  PRE_DECAP
  RAW_MATERIAL
  POST_DECAP
  POST_PACKAGING
}

enum ShiftType {
  DAY
  NIGHT
}

enum PurchaseCategory {
  CLEANING_MATERIALS
  EQUIPMENT
  SPARE_PARTS
  OTHER
}

// Requested -> warehouse checks stock -> (available: straight to Received)
// or (not available: forwarded to Accounting for approval/rejection ->
// Purchasing acknowledges the approved request -> Ordered, tracked to the
// farm gate) -> Received (Production confirms physical arrival) ->
// ConfirmedWorking (Production confirms it actually works, separate from
// just having arrived -- matters most for equipment).
enum PurchaseRequestStatus {
  REQUESTED
  // The on-site warehouse didn't have it in stock -- forwarded straight to
  // Accounting for approval/rejection. Purchasing doesn't see this until
  // Accounting has approved it (status flips to APPROVED below).
  FORWARDED_TO_ACCOUNTING
  // The warehouse DID have it -- short-circuits straight to RECEIVED once
  // the Head of Production confirms, skipping Accounting/Purchasing/Ordered
  // entirely. See warehouseAvailable/warehouseCheckedBy on PurchaseRequest.
  FULFILLED_FROM_WAREHOUSE
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  CONFIRMED_WORKING
}

// Reported (by Head of Production) -> Planned (Head of Maintenance confirms
// the damage and commits to a plan + completion date) -> Completed. Overdue
// is derived (see isStructuralIssueOverdue in src/lib/structuralIssues.ts),
// not stored -- it's just "still Planned past its proposed date."
enum StructuralIssueStatus {
  REPORTED
  PLANNED
  COMPLETED
}

enum ComplianceLevel {
  GLOBALGAP
  SPRING
  LEAF
  OTHER
  NURTURE
  AH_DL_GROW
  FAIRTRADE
  ORGANIC_100
  BIO_SUISSE
}

enum MicrobiologyStatus {
  PENDING // not yet sent to the lab
  SENT_TO_LAB // sample dispatched, awaiting result
  APPROVED
  FAILED_MINOR
  FAILED_SEVERE
}

// Simpler than MicrobiologyStatus -- an MRL reading is a straight pass/fail
// against a legal residue limit, not a graded severity.
enum MrlStatus {
  PENDING
  SENT_TO_LAB
  APPROVED
  FAILED
}

// Every lot gets a sample tested in both -- neither is a substitute for the
// other. A pallet only clears once both come back Approved; if they
// disagree (one Approved, one Failed) the whole shift goes on hold pending
// further testing, since we can't yet tell which lab is right.
enum LabType {
  IN_HOUSE
  EXTERNAL
}

enum OrderStage {
  CONFIRMED
  IN_PRODUCTION
  PACKED
  SHIPPED
  DELIVERED
  PAID
}

enum ClaimReason {
  QUALITY
  PACKAGING
  FOREIGN_MATERIAL
  TRANSPORT
}

enum ClaimSeverity {
  RED
  AMBER
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CREDITED
  CLOSED
}

enum AlertType {
  SPEC_MISMATCH
  CONTAINER_OVERDUE
  ORDER_ALLOCATION_OVERDUE
  PURCHASE_REQUEST_OVERDUE
  LOW_STOCK
  MICROBIOLOGY_PENDING
  MICROBIOLOGY_LOAD_ATTEMPT
  MRL_LOAD_ATTEMPT
  MICROBIOLOGY_REJECTED
  QUALITY_LIMIT_EXCEEDED
  QUALITY_OVERRIDE_APPROVED
  EARLY_WARNING
  SHIFT_ON_HOLD
  TEMPERATURE_EXCURSION
  GLOBALGAP_EXPIRING
  SPRAY_RESTRICTION_BLOCKED
  BLADE_KNIFE_MISMATCH
  BLADE_KNIFE_DAMAGED
  SCALE_OUT_OF_TOLERANCE
  RODENT_DETECTED
  TOOL_INVENTORY_DISCREPANCY
  SHIFT_MISSING_POST_DECAP_LINK
  CERTIFICATION_EXPIRING
  PALLET_AWAITING_RESHELVE
  PACKAGING_LOW_STOCK
}

enum AlertStatus {
  UNREAD
  READ
}

// A user with a Station set is locked to a single-purpose entry screen (used for
// shop-floor accounts — arrival inspector, post-freeze inspector, load-out supervisor)
// instead of the normal role-wide access. Null means normal, unrestricted access for their role.
enum Station {
  ARRIVAL_INSPECTION
  POST_FREEZE_INSPECTION
  LOAD_OUT
  FINAL_PRODUCT_ENTRY
  LAB
}

// Chosen at login (and changeable any time from the sidebar); drives which
// dictionary the whole app renders from and sets dir="rtl" for Arabic.
enum Locale {
  EN
  AR
}

enum QualityDecision {
  ACCEPTED
  REJECTED
}

// The call a responsible person makes once a QualityCheck trips a
// QUALITY_LIMIT_EXCEEDED alert -- separate from the inspector's own
// ACCEPTED/REJECTED decision on the form, since this is a second, senior
// review specifically of the out-of-spec reading itself.
enum QualityOverrideStatus {
  PENDING
  REJECTED
  APPROVED_AT_RISK
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  // Historical/trend financials are restricted to Owner + whoever holds this flag,
  // not the whole Sales role — deliberately narrower than order-level pricing access.
  isHeadOfSales      Boolean  @default(false)
  // Only the Owner or whoever holds this flag can sign off loading a pallet that
  // fails a client's own spec (see SpecException) — the accountability the sign-off
  // exists for only holds if the set of people who can grant it is narrow.
  isHeadOfProduction Boolean  @default(false)
  // Only the Owner or whoever holds this flag can sign the Head of Maintenance
  // side of a Cleaning Mode shift record -- same narrow-accountability
  // reasoning as isHeadOfProduction above. Not tied to a specific Role since
  // the app has no dedicated "Maintenance" role; the Owner grants it to
  // whichever user actually holds that responsibility.
  isHeadOfMaintenance Boolean @default(false)
  // Only the Owner or whoever holds this flag can approve/order a purchase
  // request -- same narrow-accountability reasoning as isHeadOfMaintenance.
  // Not tied to a Role since there's no dedicated "Purchasing" role either.
  isHeadOfPurchasing Boolean @default(false)
  // Checks the on-site warehouse for stock before a purchase request gets
  // forwarded to Purchasing -- a distinct real-world role from Head of
  // Purchasing (matches the real Release Order form's own "Store
  // Supervisor" signature line), not tied to a Role since there's no
  // dedicated "Warehouse" role either.
  isStoreSupervisor Boolean @default(false)
  // Accounting's final sign-off on a purchase request before Purchasing can
  // actually place the order -- same narrow-accountability reasoning as
  // every other isHeadOf* flag. No dedicated "Accounting" role exists
  // either.
  isHeadOfAccounting Boolean @default(false)
  station            Station?
  locale             Locale   @default(EN)
  createdAt          DateTime @default(now())

  qualityChecks            QualityCheck[]
  sentMicrobiologyResults  MicrobiologyResult[] @relation("MicrobiologySentBy")
  sentMrlResults           MrlResult[]          @relation("MrlSentBy")
  uploadedClaimAttachments ClaimAttachment[]    @relation("ClaimAttachmentUploadedBy")
  activityLogs             ActivityLog[]
  loadOutSignedContainers  Container[]          @relation("ContainerLoadOutRep")
  qualitySignedContainers  Container[]          @relation("ContainerQualityRep")
  pulledAsidePallets       PalletPullAside[]    @relation("PulledAsideBy")
  uploadedContainerLoadPhotos ContainerLoadPhoto[] @relation("ContainerLoadPhotoUploadedBy")
  containerChecklistConfirmations ContainerChecklistConfirmation[]
  cleaningProductionSignOffs  CleaningShiftRecord[] @relation("CleaningProductionSignOff")
  cleaningMaintenanceSignOffs CleaningShiftRecord[] @relation("CleaningMaintenanceSignOff")
  dailyChecklistScores DailyProductionChecklistScore[]
  verifiedQualityIssues QualityIssue[]
  recordedStaffTrainings StaffTrainingRecord[]
  metalDetectorChecks MetalDetectorCheck[] @relation("MetalDetectorCheckedBy")
  metalDetectorMaintenanceChecks MetalDetectorMaintenanceCheck[] @relation("MetalDetectorMaintenanceCheckedBy")
  chlorineDosingChecks ChlorineDosingCheck[] @relation("ChlorineDosingVerifiedBy")
  recordedLaundryRecords LaundryRecord[]
  recordedLaundryWashCycles LaundryWashCycle[]
  laundrySignOffsAsSupervisor LaundryDailySignOff[] @relation("LaundrySignOffSupervisor")
  laundrySignOffsAsVerifier   LaundryDailySignOff[] @relation("LaundrySignOffVerifiedBy")
  completedMasterCleaningTasks MasterCleaningTaskLog[]

  requestedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestedBy")
  warehouseCheckedPurchaseRequests PurchaseRequest[] @relation("PurchaseWarehouseCheckedBy")
  purchasingAcknowledgedRequests   PurchaseRequest[] @relation("PurchaseAcknowledgedBy")
  accountingApprovedPurchaseRequests PurchaseRequest[] @relation("PurchaseAccountingApprovedBy")
  orderedPurchaseRequests   PurchaseRequest[] @relation("PurchaseOrderedBy")
  receivedPurchaseRequests  PurchaseRequest[] @relation("PurchaseReceivedBy")
  workingConfirmedPurchaseRequests PurchaseRequest[] @relation("PurchaseWorkingConfirmedBy")
  uploadedPurchaseRequestPhotos    PurchaseRequestPhoto[] @relation("PurchaseRequestPhotoUploadedBy")

  reportedStructuralIssues     StructuralIssue[] @relation("StructuralIssueReportedBy")
  acknowledgedStructuralIssues StructuralIssue[] @relation("StructuralIssueAcknowledgedBy")
  confirmedStructuralIssues    StructuralIssue[] @relation("StructuralIssueConfirmedBy")
  completedStructuralIssues    StructuralIssue[] @relation("StructuralIssueCompletedBy")
  uploadedStructuralIssuePhotos StructuralIssuePhoto[] @relation("StructuralIssuePhotoUploadedBy")

  reportedNonConformanceReports  NonConformanceReport[] @relation("NonConformanceReportedBy")
  verifiedNonConformanceReports  NonConformanceReport[] @relation("NonConformanceVerifiedBy")
  uploadedNonConformanceReportPhotos NonConformanceReportPhoto[] @relation("NonConformanceReportPhotoUploadedBy")

  cancelledOrders Order[] @relation("OrderCancelledBy")
  deliveredOrders Order[] @relation("OrderDeliveredBy")
  paidOrders      Order[] @relation("OrderPaidBy")

  recordedFactoryVisits         FactoryVisit[]
  uploadedAuditFindingPhotos     ClientAuditFindingPhoto[]
  recordedProtocolAcknowledgments ProtocolAcknowledgment[]


  personalItemChecksCheckedIn  PersonalItemShiftCheck[] @relation("PersonalItemCheckedInBy")
  personalItemChecksCheckedOut PersonalItemShiftCheck[] @relation("PersonalItemCheckedOutBy")

  toolInventoryChecksCheckedIn  ToolInventoryShiftCheck[] @relation("ToolInventoryCheckedInBy")
  toolInventoryChecksCheckedOut ToolInventoryShiftCheck[] @relation("ToolInventoryCheckedOutBy")

  recordedInjuryRecords InjuryRecord[]

  recordedWasteDisposals WasteDisposalRecord[]
  recordedBannedItemScreenings BannedItemScreeningRecord[]
  recordedCleaningMaterialConsumption CleaningMaterialConsumptionRecord[]
}

// A generic "who did what, when" trail -- deliberately not tied to one entity
// type, so any action worth being accountable for (a claim status change, a
// quality override, a waste write-off, a user being added or removed) can log
// to the same place instead of each module inventing its own actor field.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  country      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  paymentTerms String?
  incoterms    String?
  currency     String   @default("USD")
  createdAt    DateTime @default(now())

  // Groups sibling entities under one mother company for the historical
  // trends view (e.g. "Chaucer - Linyi"/"Chaucer - Shandong" both set this to
  // "Chaucer"). Null means the client stands alone. A client whose own name
  // equals another client's groupName (e.g. plain "Chaucer") is treated as
  // part of that group too, without needing this field set on itself.
  groupName String?

  specs             ClientSpec[]
  orders            Order[]
  pallets           Pallet[]
  claims            Claim[]
  qualityIssues     QualityIssue[]
  dailyPackingLines DailyPackingLine[]

  @@index([name])
  @@index([groupName])
}

// One row per product-form spec (e.g. "Whole 25-35mm", "Sliced 6-8mm", "Diced 10x10x10mm").
// A client can have any number of these; each can independently exist as Grade A and/or Grade B.
// Defect tolerances are stored as free text because source spec sheets mix units
// (percentages, "3pcs/10kg" counts, "*" for not-applicable, or a note pointing at `notes`).
model ClientSpec {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  specName String // e.g. "Whole 25-35mm", "Sliced 6-8mm", "Standard"
  grade    Grade
  format   Format

  brix        String?
  ph          String?
  sizeCaliber String?

  overripe         String?
  unripe           String?
  calyx            String?
  leaves           String?
  stems            String?
  misshapen        String?
  blemish          String?
  dryPump          String?
  clumps           String?
  broken           String?
  oxidation        String?
  mechanicalDamage String?
  rotten           String?
  insectDamage     String?
  internalQuality  String?
  deadWorm         String?
  fungalInfection  String?
  dryBruises       String?
  foreignBodies    String?

  // The client's own microbiology ceiling -- distinct clients tolerate
  // different cfu/g levels, so a pallet within spec for one client can still
  // be unacceptable for a stricter one (see src/lib/cfuTier.ts).
  maxCfuPerGram Float?

  notes String?

  // See ProductionLot.isTestData -- marks a spec created purely to exercise
  // a feature during development (e.g. "CFU Test Spec"), not a real client
  // requirement.
  isTestData Boolean @default(false)

  @@index([clientId])
}

model Factory {
  id                    String  @id @default(cuid())
  name                  String  @unique
  capacityTonnesPerHour Float
  // The IQF unit code used in lot numbering, e.g. IQF 1 = "11", IQF 2 = "13".
  code                  String?
  // Packing-house accreditation -- produce from an un-coded or unauthorized
  // facility can't legally be exported, so this is the factory's own export
  // eligibility, not paperwork for one particular shipment.
  capqExportCode        String?
  nfsaAccreditationCode String?
  // The wash-tank chlorine dosing pump's target reading -- a fixed
  // equipment configuration (changes only on recalibration), not a
  // per-check value, so it's recorded here rather than on every
  // ChlorineDosingCheck row. Shown alongside each hourly reading so
  // Equipment Verification can compare actual vs. target directly.
  chlorineSetPointPpm Float?

  shifts ShiftLog[]
  lots   ProductionLot[]

  dailyTemperatureLogs DailyTemperatureLog[]
  dailyQuantityEntries DailyQuantityEntry[]
  dailyPackingLines    DailyPackingLine[]
  dailyDowntimeEvents  DailyDowntimeEvent[]
  dailyLineEfficiency  DailyLineEfficiency[]
  dailyLabourEntries   DailyLabourEntry[]
  purchaseRequests   PurchaseRequest[]
  structuralIssues   StructuralIssue[]
  cleaningAreaScores   CleaningAreaScore[]
  cleaningShiftRecords CleaningShiftRecord[]
  dailyChecklistScores DailyProductionChecklistScore[]
  metalDetectorChecks MetalDetectorCheck[]
  metalDetectorMaintenanceChecks MetalDetectorMaintenanceCheck[]
  chlorineDosingChecks ChlorineDosingCheck[]
  masterCleaningTaskLogs MasterCleaningTaskLog[]
  personalItemShiftChecks PersonalItemShiftCheck[]
  monthlyFirstAidSupplyLogs MonthlyFirstAidSupplyLog[]
  injuryRecords             InjuryRecord[]
  bladeEquipmentChecks      BladeEquipmentCheck[]
  bladeIssueRecords         BladeIssueRecord[]
  bladeIncidentReports      BladeIncidentReport[]
  packagingMaterialsDailyLogs PackagingMaterialsDailyLog[]
  packagingMaterials          PackagingMaterial[]
  forkliftEquipment           ForkliftEquipment[]
  nonConformanceReports       NonConformanceReport[]
  factoryVisits               FactoryVisit[]
  weighingScales              WeighingScale[]
  toolInventoryShiftChecks    ToolInventoryShiftCheck[]
  lightTraps                  LightTrap[]
  rodentTraps                 RodentTrap[]
  wasteDisposalRecords        WasteDisposalRecord[]
  bannedItemScreeningRecords  BannedItemScreeningRecord[]
  cleaningMaterialConsumptionRecords CleaningMaterialConsumptionRecord[]
}


// rounds/rackCount/levelCount mirror the real physical storage map exactly
// (كروكى خريطة ثلاجات مصنع التجميد.xlsx): each round is a full rack section
// (racks lettered A, B, C... up to rackCount), each rack has levelCount
// vertical slots. capacityPallets = rounds * rackCount * levelCount.
model ColdRoom {
  id              String  @id @default(cuid())
  name            String  @unique
  capacityPallets Int
  isNew           Boolean @default(false)
  rounds          Int     @default(1)
  rackCount       Int     @default(1)
  levelCount      Int     @default(1)

  pallets Pallet[]
  slots   ColdRoomSlot[]
  pullAsides PalletPullAside[]
}

// One row per physical storage position. Generated in full when a cold room
// is created (rounds * rackCount * levelCount rows) so empty slots are just
// as visible as occupied ones -- matching the manual map, which shows the
// whole grid, not just where pallets currently are.
model ColdRoomSlot {
  id         String   @id @default(cuid())
  coldRoomId String
  coldRoom   ColdRoom @relation(fields: [coldRoomId], references: [id])
  round      Int
  rack       String
  level      Int
  palletId   String?  @unique
  pallet     Pallet?  @relation(fields: [palletId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([coldRoomId, round, rack, level])
  @@index([coldRoomId])
}

// A pallet pulled out of its slot only to reach others behind it during
// load-out -- not shipped, not generally "unassigned", but genuinely
// displaced and owed a specific way back. Kept as its own record (not just
// a boolean on Pallet) so there's a durable trail of who pulled it, when,
// why, and -- once resolved -- exactly which slot it went back into. Not
// deleted on resolution, the same way ContainerPalletLine or SpecException
// keep a permanent record rather than being cleared once done.
// palletId isn't @unique -- the same pallet can legitimately be pulled
// aside more than once across its lifetime -- but the app only ever
// creates a second row after the first is resolved (enforced in
// pullPalletAsideAction, not the schema, since Prisma can't express a
// partial/filtered unique constraint here).
model PalletPullAside {
  id             String    @id @default(cuid())
  palletId       String
  pallet         Pallet    @relation(fields: [palletId], references: [id])
  coldRoomId     String
  coldRoom       ColdRoom  @relation(fields: [coldRoomId], references: [id])
  round          Int
  rack           String
  reason         String?
  pulledAt       DateTime  @default(now())
  pulledByName   String?
  pulledByUserId String?
  pulledByUser   User?     @relation("PulledAsideBy", fields: [pulledByUserId], references: [id])
  resolvedAt     DateTime?
  resolvedSlotId String?

  @@index([coldRoomId])
  @@index([palletId])
}

// Real farm-layout data (Farm/Station/Valve/Variety/boundary geometry) is
// imported from the farm's own GIS system (a GeoPackage export) -- see
// scripts/import-fields.ts. Fields entered by hand (no GIS match) simply
// leave the extra columns null.
model Field {
  id           String  @id @default(cuid())
  name         String  @unique
  mapReference String?

  farmName        String? // e.g. "MAFA 4"
  // Short code used in ProductionLot's lot-number prefix (e.g. "M4" for
  // "MAFA 4") -- distinct from capqFarmCode/nfsaFarmCode below, which are
  // certification-body codes, not the lot-numbering abbreviation.
  farmCode        String?
  // Same farm-level accreditation, same code repeated across every field
  // belonging to it -- matches how farmName itself is already denormalized
  // per field row rather than needing a separate Farm entity.
  capqFarmCode    String?
  nfsaFarmCode    String?
  station         String? // irrigation station/block, e.g. "2"
  valve           String? // specific plot within the station, e.g. "1A"
  variety         String? // strawberry variety code, e.g. "MO", "ML52"
  areaFeddans     Float?
  plantingDate    String? // free text -- source mixes years, "Adult", "G2020", "1995&2020"
  avgTonPerFeddan Float? // average of the last few seasons' ton/feddan on file
  googleMapsUrl   String?

  // Polygon boundary in the source GIS's coordinates (UTM Zone 36N, meters),
  // for rendering the schematic field-layout map -- centroid plus one or
  // more rings of [x, y] points. Not a real geo type since this is just for
  // our own map rendering, not spatial queries.
  centroidX Float?
  centroidY Float?
  boundary  Json?

  // Same boundary/centroid reprojected to WGS84 (lat/lng) for plotting on a
  // real basemap (see /fields) -- see scripts/reproject-fields.ts.
  latitude       Float?
  longitude      Float?
  boundaryLatLng Json? // one or more rings of [lat, lng] points

  productionLots     ProductionLotField[]
  qualityChecks      QualityCheck[]
  harvestTicketLines HarvestTicketPlotLine[]
  sprayRecords       FieldSprayRecord[]
}

// A field sprayed with an anti-fungal (typically after rain) can't be
// harvested again until noHarvestDays have passed -- checked against every
// Harvest Ticket plot line that resolves to this field (see
// src/lib/fieldSpray.ts + the hard-block in harvest-tickets/actions.ts).
// noHarvestDays defaults to 12 but is editable per record since different
// products can carry a different pre-harvest interval.
model FieldSprayRecord {
  id            String   @id @default(cuid())
  fieldId       String
  field         Field    @relation(fields: [fieldId], references: [id])
  chemicalName  String
  sprayDate     DateTime
  noHarvestDays Int      @default(12)
  sprayedByName String?
  reason        String?

  // The standard's required pre-harvest interval, distinct from
  // noHarvestDays above (the interval actually applied) -- lets a shorter
  // actual wait than the standard's limit show up as a real compliance gap
  // instead of being indistinguishable from full compliance.
  phiLimitDays           Int?
  leafCompliancePct      Float?
  globalGapCompliancePct Float?
  nurtureCompliancePct   Float?
  fairtradeCompliancePct Float?

  notes      String?
  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([fieldId])
}

enum HarvestProductType {
  RAW
  FINAL
  REWORK
}

// GEN03107 "Product delivery sheet" -- filled out by the field/harvest team
// before a tractor leaves for the decap facility. A single delivery can draw
// from several plots at once, hence the separate line-item table below; the
// receipt section at the bottom is filled in later, by the decap facility,
// once the tractor actually arrives. Pre-Decap Inspection (STR03101) links to
// this via serialNumber (its own "Serial Number (Receipt)" field) to know
// which plot the QC sample was actually drawn from.
model HarvestTicket {
  id           String  @id @default(cuid())
  serialNumber String  @unique
  ggn          String?

  complianceLevel ComplianceLevel?
  complianceOther String?
  productType     HarvestProductType?
  reworkReason    String?

  // Simple pass/fail checklist (left side of the form).
  fruitConformityOk    Boolean?
  fruitSafetyOk        Boolean?
  cratesCleanlinessOk  Boolean?
  fieldCleanlinessOk   Boolean?
  vehicleCleanlinessOk Boolean?

  // Yes/No presence checklist, each with its own corrective action if flagged.
  petsPresent                      Boolean?
  petsPresentAction                String?
  animalProductionNearby           Boolean?
  animalProductionNearbyAction     String?
  wildDomesticAnimalActivity       Boolean?
  wildDomesticAnimalActivityAction String?
  rodentDogActivity                Boolean?
  rodentDogActivityAction          String?

  loadingSupervisor   String?
  loadingTime         DateTime?
  transferredBy       String? // transport method/vehicle description
  vehicleNo           String?
  authorizedGrower    String? // farm name/code
  cropName            String?
  harvestTime         DateTime?
  harvestSupervisor   String?
  harvestDate         DateTime?
  ipmConfirmationDate DateTime? // from IPM03208

  // Packhouse/decap-facility receipt section -- completed on arrival.
  receivedDate           DateTime?
  receivedTime           DateTime?
  deliveryNumber         String?
  cratesReceived         Int?
  palletsReceived        Int?
  grossWeightKg          Float?
  netWeightKg            Float?
  electronicWeightCardNo String?
  productTempC           Float?
  optimumTempC           Float?
  coldTruckTempC         Float?
  acceptedAtPackhouse    Boolean?
  receivedByName         String?

  createdAt DateTime @default(now())

  plotLines HarvestTicketPlotLine[]
}

model HarvestTicketPlotLine {
  id              String        @id @default(cuid())
  harvestTicketId String
  harvestTicket   HarvestTicket @relation(fields: [harvestTicketId], references: [id], onDelete: Cascade)

  stationNo     String?
  plotValveGhNo String?
  fieldId       String?
  field         Field?  @relation(fields: [fieldId], references: [id])

  varietyName  String?
  cycleNumber  String?
  plantingYear String?
  cutNo        String?
  palletsCount Int?
  cratesCount  Int?
  weightKg     Float?

  qualityChecks QualityCheck[]

  @@index([harvestTicketId])
  @@index([fieldId])
}

model ShiftLog {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Factory   @relation(fields: [factoryId], references: [id])
  date        DateTime
  shiftType   ShiftType
  startTime   DateTime
  // Not asked at shift-open time -- nobody knows it yet. Filled in
  // automatically once the day's Daily Report records this shift's line
  // uptime (see updateLineEfficiencyAction), or entered by hand if known.
  endTime     DateTime?
  // Optional -- the real per-role headcount lives in the Daily Report's
  // Labour Distribution breakdown. Null when a shift is auto-created (e.g.
  // by logging a Production Lot before anyone opened the shift by hand);
  // still asked for on the manual Log Shift form.
  workerCount Int?
  createdAt   DateTime  @default(now())

  // Set when a lot from this shift gets a split microbiology result (one lab
  // approves, the other fails) -- every lot from the same shift is held
  // until further testing resolves the disagreement, since the contamination
  // risk isn't known to be specific to just the one sampled lot.
  onHold             Boolean   @default(false)
  holdReason         String?
  holdSince          DateTime?
  holdResolvedAt     DateTime?
  holdResolvedBy     String?
  holdResolutionNote String?

  lots  ProductionLot[]
  waste Waste[]

  @@unique([factoryId, date, shiftType])
  @@index([factoryId, date])
}

// Decap's own shift -- deliberately NOT tied to a factory. Decap is a single
// shared facility: fruit from every field arriving during a given date+shift
// is mixed together there, and only afterward does the arrival office decide
// which factory each pallet goes to. So "which fields supplied this shift"
// is the same answer for both IQF1 and IQF2 -- one DecapShift row covers
// both, unlike ShiftLog which is always factory-specific.
model DecapShift {
  id            String         @id @default(cuid())
  date          DateTime
  shiftType     ShiftType
  qualityChecks QualityCheck[]
  createdAt     DateTime       @default(now())

  @@unique([date, shiftType])
}

// A singleton row (find-or-create on first access) for company-wide facts
// that don't belong to any one factory/field.
model CompanySettings {
  id String @id @default(cuid())

  // Farm-level GlobalG.A.P. accreditation -- every field currently shares the
  // same certification, so this lives once here rather than denormalized
  // across every Field row (unlike farmName/capqFarmCode/nfsaFarmCode, which
  // predate this and were already accepted as per-field duplication).
  globalGapNumber String?
  globalGapExpiry DateTime?
}

// lotNumber is auto-generated: {farmCode}{factory.code}{YY}{DDD}-{shift digit}
// e.g. M41126146-1 = farm M4, IQF 1 (code 11), 2026, day 146 (26 May), shift 1 (day).
model ProductionLot {
  id               String   @id @default(cuid())
  lotNumber        String   @unique
  farmCode         String
  shiftId          String
  shift            ShiftLog @relation(fields: [shiftId], references: [id])
  factoryId        String
  factory          Factory  @relation(fields: [factoryId], references: [id])
  grade            Grade
  format           Format
  isEndOfDayGradeB Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Marks a lot created purely to exercise a feature during development
  // (e.g. lotNumber "TEST1126210-1") -- surfaced as a visible warning
  // wherever the lot is shown so it's never mistaken for real production.
  isTestData Boolean @default(false)

  // A shift's fruit genuinely comes from more than one field at once (e.g.
  // two plots delivering the same day) -- this is a many-to-many join, not
  // the single required fieldId this used to be. See ProductionLotField.
  fields              ProductionLotField[]
  pallets             Pallet[]
  qualityChecks       QualityCheck[]
  microbiologyResults MicrobiologyResult[]
  mrlResult           MrlResult?
  qualityIssues       QualityIssue[]

  @@index([factoryId, grade])
}

// Which field(s) supplied a given lot's shift -- the authoritative source for
// "Fields Supplying" on the lot detail page and for direct traceability hits,
// replacing the old single ProductionLot.fieldId column and the time-window
// heuristics that used to approximate this.
model ProductionLotField {
  id        String        @id @default(cuid())
  lotId     String
  lot       ProductionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fieldId   String
  field     Field         @relation(fields: [fieldId], references: [id])
  createdAt DateTime      @default(now())

  @@unique([lotId, fieldId])
  @@index([fieldId])
}

// cartonLogo/cartonSize/variety are physical carton attributes fixed at packing.
// packing*/palletization* fields mirror form GEN03115 "Identification of Packed
// Pallets" — filled out by the Final Product Entry role as each pallet is wrapped,
// which is what actually creates most Pallet rows (a lot can also still be bulk
// pallet-generated at production time as a quicker fallback — see createLotAction).
// loadingStart/loadingEnd (on ContainerPalletLine) are a separate, later moment:
// when the pallet is loaded into a container for shipment.
// The physical pallet base itself is a durable, reusable asset with its own
// branded number -- it isn't created per lot, and the same number legitimately
// comes back under a different lot once its previous cargo has shipped and it
// re-enters rotation. So palletNumber alone is never unique; what's actually
// unique is "this physical pallet, on this particular production run".
model Pallet {
  id           String        @id @default(cuid())
  palletNumber String
  lotId        String
  lot          ProductionLot @relation(fields: [lotId], references: [id])
  coldRoomId   String?
  coldRoom     ColdRoom?     @relation(fields: [coldRoomId], references: [id])
  weightTonnes Float         @default(1.2)
  status       PalletStatus  @default(IN_STORAGE)
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  createdAt    DateTime      @default(now())

  cartonLogo String?
  cartonSize String?
  variety    String?

  // GEN03115 fields
  clientSpecNote     String? // اسم العميل — intended client, may be set before a formal Order exists
  qualityGrade       Grade? // standalone from client — defaults to the lot's grade but overridable per pallet at pack time
  isMixedVariety     Boolean   @default(false)
  fullPallet         Boolean   @default(true)
  totalCartons       Int?
  packingDate        DateTime?
  packingLocation    String?
  packingSupervisor  String?
  palletizationStart DateTime?
  palletizationEnd   DateTime?

  // Whether this pallet's fruit is calibrated or uncalibrated -- a single
  // packer classification at packing time, not a re-entry of the detailed
  // size-band measurements already captured at Post-Freeze Inspection
  // (QualityCheck.fruitDiameterCalibratedSmall/Medium/Large). Null = not yet
  // set.
  fruitDiameterCalibrated Boolean?

  // Cartons packed without a confirmed client/sale go out blank and need a
  // client sticker applied at the load-out bay before they can go in the container.
  stickeringRequired    Boolean   @default(false)
  stickeringCompletedAt DateTime?

  // See ProductionLot.isTestData -- same purpose, tracked per-pallet too
  // since a pallet created for testing can be re-palletized under a later,
  // genuinely real lot.
  isTestData Boolean @default(false)

  waste          Waste[]
  qualityChecks  QualityCheck[]
  loadLines      ContainerPalletLine[]
  slot           ColdRoomSlot?
  specExceptions SpecException[]
  pullAsides     PalletPullAside[]

  @@unique([palletNumber, lotId])
  @@index([palletNumber])
  @@index([status])
  @@index([coldRoomId])
}

// Mirrors the real inspection forms:
// - PRE_DECAP:       STR03101 "Packhouse intake quality assessment: Strawberry for decapping"
//                     (fruit arriving at the decap facility from the field)
// - POST_DECAP:      STR03107 "Final product strawberry inspection: decapping"
//                     (greenlight for fruit to leave the decap facility for the factory)
// - RAW_MATERIAL:    STR03110 "Inspection of Prepared Strawberries Upon Receipt"
// - POST_PACKAGING:  STR03111 / STR03116 "Inspection of Frozen Strawberries at End of Line" (Grade A / B)
// Fields not relevant to a given checkpoint are simply left null.
model QualityCheck {
  id                      String                 @id @default(cuid())
  // Nullable: raw-material checks happen at the receiving dock before a
  // production lot exists, so they're logged standalone. Post-packaging
  // checks are still tied to the lot they came from (enforced in the action).
  lotId                   String?
  lot                     ProductionLot?         @relation(fields: [lotId], references: [id])
  palletId                String?
  pallet                  Pallet?                @relation(fields: [palletId], references: [id])
  // Which decap shift this check belongs to -- only Post-Decap Quality
  // populates this. Decap is ONE shared facility serving both IQF factories:
  // fruit from every field that arrives during a given date+shift gets mixed
  // together there, and the arrival office only decides afterward which
  // factory each pallet goes to (whichever has less stock). So "which fields
  // supplied this shift" is the same answer for both factories -- a
  // DecapShift is deliberately NOT tied to one factory, unlike ShiftLog.
  decapShiftId            String?
  decapShift              DecapShift?            @relation(fields: [decapShiftId], references: [id])
  // The specific field plot this batch came from, for checks that can be
  // tied to one field (Pre-Decap Inspection and Post-Decap Quality). A single
  // delivery can carry fruit from multiple fields per the harvest ticket, so
  // this is a one-field-at-a-time link, not the full per-field crate breakdown.
  fieldId                 String?
  field                   Field?                 @relation(fields: [fieldId], references: [id])
  // Pre-Decap Inspection links here directly, by Harvest Ticket Serial Number,
  // to record exactly which plot line the sample was drawn from -- independent
  // of whether that plot line's station/valve happened to resolve to a Field
  // record (fieldId above), since real harvest tickets don't always match.
  harvestTicketPlotLineId String?
  harvestTicketPlotLine   HarvestTicketPlotLine? @relation(fields: [harvestTicketPlotLineId], references: [id])
  checkpoint              QualityCheckpoint

  // Both checkpoints end in an Acceptable/Unacceptable call + corrective action
  // (the "notes" field below). appliesToWholeDelivery is RAW_MATERIAL only: a
  // supervisor can reject an entire truckload outright without inspecting every pallet on it.
  decision               QualityDecision?
  appliesToWholeDelivery Boolean          @default(false)

  complianceLevel ComplianceLevel?
  complianceOther String?
  shiftNumber     String?

  // Shared measurements
  brix                 Float
  fruitColorPct        Float?
  internalQualityPct   Float?
  acidityPh            Float?
  productTemperatureC  Float?
  varietyName          String?
  sampleCollectionTime DateTime?
  sampleWeightKg       Float?

  // Defect items shared across STR03107, STR03110, and STR03111/STR03116 (same
  // % unit, different limit per form — the limit is enforced in the UI, not the DB).
  incompleteMaturityPct Float?
  shapeDeformitiesPct   Float?
  oxidationPct          Float?
  foreignBodiesPct      Float?
  insectsLarvaePct      Float?
  totalDefectsPct       Float?
  foreignOdor           String?
  foreignTaste          String?
  overmaturePct         Float?

  // STR03110 — raw material intake only (Arrival Inspection at Factory)
  sampleNo                String?
  rawMaterialSource       String?
  farmCode                String?
  decapPackHouse          String? // which decapping pack house this delivery is arriving from
  decapQcApprover         String? // the QC number (QC1-QC51) who approved it to leave the decap facility -- required on Post-Decap Quality itself, optionally echoed here
  transportVehicleNo      String?
  receiptNoteNo           String?
  numberOfBoxesReceived   Int?
  crateWeightKg           Float?
  sizeCaliber             String?
  moldSignsPct            Float? // بوادر عفن — distinct from Mold itself (mouldPct)
  capsuleRemainsPct       Float? // بقايا الكبسولة (STR03110 measures this as a %)
  birdFoodPct             Float? // اكل طيور
  seedClusteringPct       Float? // تجمع البذور
  bruisesPct              Float? // كدمات
  dryCavitiesPct          Float? // تجاويف جافة
  overDecappingPct        Float? // تجهير جائر
  sandDustPct             Float? // تربة/رمال
  leafStemRemainsCount    Float? // بقايا اوراق / سيقان — limit is 1 piece/1kg
  brokenUncleanPalletsPct Float? // باليتات مكسورة او غير نظيفة
  unfumigatedPalletsPct   Float? // باليتات غير مبخرة
  brokenUncleanCratesPct  Float? // اطباق مكسورة او غير نظيفة

  // Post-Decap Quality only (STR03107) -- checked right after decapping, the
  // greenlight for fruit to proceed from the decap facility to the factory.
  // Its defect checklist is otherwise identical to STR03110's (reused above).
  processingLine      String? // رقم السير
  divertedTo          String? // تم تحويل الشحنة الى -- where a nonconforming shipment was diverted (e.g. local market)
  retrainingRequested Boolean? // اعادة تدريب مجموعة التجهيز -- packing group re-training requested

  // Pre-Decap Inspection only (STR03101) -- fruit arriving at the decap
  // facility from the field, before decapping. Cleaning/crates is a pass/fail
  // check, not a percentage, hence the boolean. harvestSupervisor is not on
  // the paper form itself but is who STR03101's own instructions say to
  // notify (via GEN03108) if the delivery has defects.
  harvestSupervisor    String?
  cleaningGoodCratesOk Boolean? // نظافه وسلامه الصناديق
  diameterUnder22mmPct Float? // قطر اقل من 22مم
  botrytisPct          Float? // عفن ثمار (Botrytis specifically, distinct from mouldPct)
  earlyBotrytisPct     Float? // بوادر عفن ثمار مبكرة -- early-warning signs, tighter limit than full Botrytis -- limit ≤1%
  pestDiseasePct       Float? // حشرات / امراض
  insectDamagePct      Float? // ضرر حشري -- limit ≤5%
  wormEatenPct         Float? // اكل دود
  birdTracesPct        Float? // آثار طيور -- limit ≤5%
  leavesStalksPct      Float? // اوراق او سيقان -- limit ≤5%

  // STR03111 / STR03116 — post-packaging only
  clientName                    String?
  operationDate                 DateTime?
  expiryDate                    DateTime?
  fullPallet                    Boolean?
  cartonWeightKg                Float?
  packageClosureOk              Boolean?
  dataLabelReviewOk             Boolean?
  fruitDiameterUncalibrated     String?
  fruitDiameterCalibratedSmall  String?
  fruitDiameterCalibratedMedium String?
  fruitDiameterCalibratedLarge  String?
  // STR03118 (Sliced) size classification -- سمك الشرائح
  sliceThicknessNarrow String? // 6-8mm
  sliceThicknessWide   String? // 8-10mm
  // STR03119 (Diced) size classification -- المكعبات
  cubeSizeSmall String? // 10x10x10mm
  cubeSizeLarge String? // 20x20x20mm
  capsuleRemainsCount           Float? // بقايا الكبسولة — measured as pieces/10kg here, distinct unit from raw's capsuleRemainsPct
  leafRemainsCount              Float? // رض الاوراق وبقايا اوراق — pieces/10kg
  stemFragmentsCount            Float? // السيقان وشظايا الساق — pieces/10kg
  cohesiveClustersPct           Float? // كتل متماسكة (2:3 قطع)
  crushedBrokenFruitPct         Float? // ثمار محطمة/مكسورة
  dryBruisesPct                 Float? // خبطات جافة
  mechanicalFactorsPct          Float? // عوامل ميكانيكية
  fungalInfectionPct            Float? // اصابة فطرية
  insectInfestationPct          Float? // اصابة حشرية (distinct from insectsLarvaePct)
  frozenProductWaitMinutes      Float? // فترة انتظار المنتج المجمد

  // Legacy/general defect fields
  mouldPct      Float?
  skinDamagePct Float?
  firmnessScore Float?

  notes String?

  // Set only when this check trips a QUALITY_LIMIT_EXCEEDED alert -- the
  // responsible person's call on whether to reject outright or sign off to
  // proceed at their own risk, made from the Alerts page.
  overrideStatus    QualityOverrideStatus?
  overrideByName    String?
  overrideSignature String?
  overrideNote      String?
  overrideAt        DateTime?

  inspectorId String?
  inspector   User?    @relation(fields: [inspectorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([lotId, checkpoint])
  @@index([palletId])
}

// A sample from every lot/shift is tested in BOTH our in-house lab and an
// external lab -- one row per (lot, labType), never a substitute for each
// other. See raiseShiftOnHoldAlert in src/lib/alerts.ts for what happens
// when the two disagree.
model MicrobiologyResult {
  id           String             @id @default(cuid())
  lotId        String
  lot          ProductionLot      @relation(fields: [lotId], references: [id])
  labType      LabType
  status       MicrobiologyStatus @default(PENDING)
  receivedDate DateTime?
  notes        String?

  // Dispatch — when the sample was actually sent out to the lab, tracked
  // separately from the result so the lab rep can see what's in flight.
  // Not applicable to the in-house lab, which tests on-site.
  sentDate     DateTime?
  sentByUserId String?
  sentBy       User?     @relation("MicrobiologySentBy", fields: [sentByUserId], references: [id])
  trackingRef  String?

  // Shared by both lab types -- both real certificates on file (in-house's
  // QR MIC 13/100, and external lab "Healthy Labs" Test Certificate) turned
  // out to have essentially the same shape: a client/sample header, a
  // repeatable tests table, and a reviewed/approved sign-off.
  certificateNumber String? // in-house "Certificate No."; external "Certificate Code" e.g. "MGF 0622\26"
  labName           String? // e.g. "Healthy Labs — Healthy Laboratories for Food and Water Testing"
  clientName        String? // "Client" -- the requesting entity, not a sales client
  clientAddress     String?
  attentionTo       String? // external cert's "Attention" -- the contact person at Magrabi, e.g. "Eng. Adel Elzalabany"
  sampleCode        String? // in-house "Sample Code"; external "Sample Code" (distinct code from our own lotNumber)
  sampleType        String? // e.g. "Strawberry Frozen, Lot: M 41126059-1, Reduplicate: 1/3, Sample Date: 06/05/2026"
  sampleSize        String? // e.g. "1 kg"
  sampleCondition   String? // e.g. "Kept frozen"
  sampleData        String? // in-house "Data of Sample" (بيانات العينة)
  otherData         String? // in-house "Other Data" (بيانات آخري)
  reportDate        DateTime?
  recommendation    String? // in-house only -- external cert has no equivalent line
  preparedBy        String? // in-house only -- "Documents Section"; external cert has no equivalent
  reviewedBy        String? // in-house "Head Section Lab"; external e.g. "Quality Manager"
  approvedBy        String? // in-house "Labs Director"; external e.g. "Lab Manager"
  analysisStartDate DateTime? // in-house "Analysis Date"; external "Testing Date"
  analysisEndDate   DateTime? // in-house "Analysis ended in"; external certs are usually same-day, leave blank
  personInCharge    String?
  resultsSummary    String? // free text catch-all; testLines below is the structured form

  // A dedicated structured field for this one specific test (Total/Aerobic
  // Plate Count), distinct from the free-text testLines table below -- this
  // is the only test result the app needs to parse into a number (for the
  // cfu/g tier system), so it gets its own numeric column rather than trying
  // to parse it back out of testLines[].result, which stays free text since
  // a reading there can be a count, "<10", or "Not Detected".
  totalPlateCountCfuG Float?

  testLines MicrobiologyTestLine[]

  // Older external residue/contaminant certificates (e.g. chlorates &
  // perchlorates panels) that don't fit the shared shape above -- kept for
  // that case, left blank for both in-house and the standard external
  // microbiology certificate.
  sampleId          String? // e.g. "Dokki-2026-170105"
  protocolNumber    String? // e.g. "MAFA 04- IQF UNIT (11) LOT-M41126146-1" — the lab's own reference, distinct from our lotNumber
  samplingBagSerial String? // the certificate's own "Lot Number" field is actually this, not our lot number — kept distinct to avoid confusion
  samplingPlace     String? // e.g. "M4 FARM" — free text, not forced to match a Field record exactly
  methodName        String? // e.g. "Chlorates & Perchlorates" -- single-panel certs only; the standard case uses testLines above

  // The certificate file itself, stored on local disk outside public/ and
  // only ever served through an authenticated route — see src/lib/files.ts.
  certificateFileName         String? // generated on-disk filename
  certificateFileOriginalName String? // original filename, for display

  // Rejection detail — only meaningful when status is FAILED_MINOR/FAILED_SEVERE.
  rejectedQuantityTonnes Float? // volume that did not make spec
  rejectionReason        String? // why it failed
  correctiveAction       String? // what was done about it

  // See ProductionLot.isTestData -- marks a result fabricated purely to
  // exercise a feature during development, not a genuine lab certificate.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([lotId, labType])
  @@index([lotId, status])
}

// The repeatable "Tests" table shared by both certificates -- e.g. "Aerobic
// total plate count 30°C" / "3000 cfu/g" / "ISO 4833 2013" (in-house adds a
// separate `unit` column; external expresses measurement uncertainty (MU)
// instead, e.g. "± 0.015"). `result` is free text since a reading can be a
// count, "<10", or "Not Detected".
model MicrobiologyTestLine {
  id                   String             @id @default(cuid())
  microbiologyResultId String
  microbiologyResult   MicrobiologyResult @relation(fields: [microbiologyResultId], references: [id], onDelete: Cascade)

  testName               String?
  result                 String?
  unit                   String?
  measurementUncertainty String? // external cert's "MU" column, e.g. "± 0.015"
  methodRef              String?

  @@index([microbiologyResultId])
}

// Maximum Residue Limit (pesticide/agrochemical) testing, per lot. Added
// even though the farms run a biological-control program with no synthetic
// spraying -- per the Owner, "we lose nothing by including it." Unlike
// MicrobiologyResult there's no in-house/external split (one external lab
// test per lot, since there's no in-house MRL capability), and this gates
// load-out exactly the way microbiology does in addPalletLoadLineAction
// (see src/lib/mrl.ts, src/app/(app)/logistics/actions.ts).
model MrlResult {
  id    String    @id @default(cuid())
  lotId String    @unique
  lot   ProductionLot @relation(fields: [lotId], references: [id])
  status MrlStatus @default(PENDING)

  sentDate     DateTime?
  sentByUserId String?
  sentBy       User?     @relation("MrlSentBy", fields: [sentByUserId], references: [id])
  trackingRef  String?

  labName           String?
  certificateNumber String?
  sampleCode        String?
  reportDate        DateTime?
  analysisDate      DateTime?
  notes             String?

  certificateFileName         String?
  certificateFileOriginalName String?

  rejectionReason String?

  // See ProductionLot.isTestData -- marks a result fabricated purely to
  // exercise a feature during development, not a genuine lab certificate.
  isTestData Boolean @default(false)

  createdAt DateTime @default(now())
}

model Waste {
  id       String    @id @default(cuid())
  // Exactly one of these is set, depending on where the waste happened.
  // Finished pallets that spoil/fail in storage link to the pallet directly.
  // Raw fruit rejected off the inspection belt (before any lot/pallet exists)
  // never gets weighed piece-by-piece -- it's gathered and weighed once at
  // the end of the shift, so it links to the shift as a whole instead.
  palletId String?
  pallet   Pallet?   @relation(fields: [palletId], references: [id])
  shiftId  String?
  shift    ShiftLog? @relation(fields: [shiftId], references: [id])
  quantity Float
  reason   String
  date     DateTime  @default(now())
}

enum WasteClassification {
  HAZARDOUS
  ORGANIC
  OTHER
}

// The daily disposal register (HSE03215-shaped) -- who disposed of what,
// how, and where, classified for regulatory purposes. Deliberately separate
// from Waste above: that model links a quantity back to the pallet/shift it
// came from for yield reporting, while this is the actual paper disposal
// log (supervisor sign-off, disposal method, hazardous/organic/other) with
// no reporting relationship to a specific pallet or shift.
model WasteDisposalRecord {
  id             String              @id @default(cuid())
  factoryId      String
  factory        Factory             @relation(fields: [factoryId], references: [id])
  date           DateTime
  supervisorName String
  disposalMethod String
  location       String?
  classification WasteClassification
  notes          String?

  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([factoryId, date])
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     String     @unique // our own internal reference, auto-generated
  poNumber        String? // the client's own purchase-order number, optional -- may not exist or arrive later
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id])
  grade           Grade
  format          Format
  quantityPallets Int
  valueUsd        Float
  stage           OrderStage @default(CONFIRMED)
  orderDate       DateTime
  shipDate        DateTime?
  isHistorical    Boolean    @default(false)
  createdAt       DateTime   @default(now())

  // A client backing out is a real outcome the lifecycle previously had no
  // path for -- an order with no way to cancel just sits at CONFIRMED
  // forever. Kept as its own timestamp rather than an OrderStage value since
  // cancellation is an orthogonal terminal state reachable from more than
  // one point in the sequence, not a "next" step in it. Allocated pallets
  // are released back to stock (status/clientId/orderId cleared) at the
  // point of cancellation -- see cancelOrderAction.
  cancelledAt        DateTime?
  cancelledByName    String?
  cancelledByUserId  String?
  cancelledByUser    User?     @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id])
  cancellationReason String?

  // Delivered/Paid are the only two steps left that are genuine real-world
  // attestations nothing in the data can derive on its own -- everything
  // before Shipped is computed, and Shipped itself auto-advances the moment
  // every allocated pallet actually ships. These two capture who/when/what
  // reference, the same accountability pattern every other sign-off in this
  // app already uses (e.g. Container's loadOutRepName/loadOutSignedAt),
  // instead of being a bare stage flip.
  deliveredAt       DateTime?
  deliveredByName   String?
  deliveredByUserId String?
  deliveredByUser   User?     @relation("OrderDeliveredBy", fields: [deliveredByUserId], references: [id])
  deliveryReference String? // e.g. POD number, carrier tracking confirmation

  paidAt           DateTime?
  paidByName       String?
  paidByUserId     String?
  paidByUser       User?     @relation("OrderPaidBy", fields: [paidByUserId], references: [id])
  paymentReference String? // e.g. wire reference, invoice number

  pallets       Pallet[]
  containers    Container[]
  qualityIssues QualityIssue[]

  @@index([clientId])
  @@index([stage])
}

// A container holds ~25t loose-packed or ~24t palletised; since a pallet is
// 1.2t, that rarely divides evenly. Large orders span multiple containers,
// and the pallet that's mid-way through when a container fills up gets its
// remaining cartons carried into the next container (see ContainerPalletLine).
model Container {
  id                             String    @id @default(cuid())
  orderId                        String
  order                          Order     @relation(fields: [orderId], references: [id])
  containerNumber                String    @unique
  carrier                        String?
  departurePort                  String?
  destinationPort                String?
  // A port name alone doesn't make the country obvious, and doesn't say
  // whether the port itself is the end of the line or just where this
  // container transships onward (by another vessel, or overland) to reach
  // its actual final country -- this makes that explicit instead of
  // implied by the port name.
  destinationCountry             String?
  departureDate                  DateTime?
  expectedTransitDays            Int?
  currentLocation                String?
  trackingProvider               String?
  trackingRef                    String?
  // The tamper-evident seal locked on after loading, and the shipping
  // line's own bill of lading number -- both are what a client, customs
  // broker, or bank (for L/C terms) actually reference for this specific
  // shipment, and what proves the container wasn't opened in transit.
  sealNumber                     String?
  billOfLadingNumber             String?
  // Which vessel/voyage this container is actually on, and the carrier's own
  // booking reference -- booking usually exists before the container number
  // is even assigned, and vessel/voyage is what a tracking-provider
  // integration would key off once one's wired up.
  vesselName                     String?
  voyageNumber                   String?
  bookingNumber                  String?
  // Export paperwork, separate from the factory's own Certificate of
  // Quality -- these are what customs and the client's own import broker
  // actually ask for. Mirrors Egypt's real fresh-produce export clearance
  // chain: a Nafeza inspection request triggers CAPQ/NFSA to inspect and
  // seal the reefer on-site under the "Bolsa" permit, samples get tested
  // for the NFSA health certificate, and the shipment gets its customs
  // declaration filed on Nafeza. Phytosanitary and fumigation certificates
  // are situational, not universal -- fumigation only applies to wooden
  // packaging (ISPM 15) and phytosanitary requirements vary by crop and
  // destination market, so neither is required on every shipment.
  nafezaInspectionRequestRef     String?
  bolsaPermitNumber              String?
  phytosanitaryCertNumber        String?
  nfsaHealthCertNumber           String?
  fumigationCertNumber           String?
  certificateOfOriginNumber      String?
  customsExportDeclarationNumber String?
  // The reefer's target temperature for this shipment (IQF frozen product is
  // normally -18°C) -- readings during transit get compared against this to
  // catch an excursion, not stored as their own pass/fail flag, so a
  // corrected set-point doesn't retroactively change what counted as a
  // problem at the time.
  reeferSetPointC                Float?
  createdAt                      DateTime  @default(now())

  // Load-out manifest header (GEN03115): captured when pallets are loaded for shipment.
  loadingDate       DateTime?
  loadingLocation   String?
  loadingSupervisor String?
  loadType          LoadType?

  // A few extra fields from the Product Loading and Despatch Statement
  // (Form# ACC01127) that the GEN03115 manifest above doesn't capture --
  // informational only, not part of the pre-departure checklist/sign-off
  // gating (that stays on the existing 2-rep confirmation).
  globalGapCertified Boolean?
  loadingTempC       Float?
  tempRecorderNumber String?
  forkliftDriverName String?

  // Sign-off once loading is complete: one rep from the load-out team, one
  // from quality. The name is who actually signed (for the certificate/print
  // record); the userId ties it to the logged-in account that submitted it,
  // so it can't be spoofed by typing someone else's name, and so the two
  // sign-offs can be checked as genuinely two different people.
  loadOutRepName   String?
  loadOutRepUserId String?
  loadOutRepUser   User?     @relation("ContainerLoadOutRep", fields: [loadOutRepUserId], references: [id])
  loadOutSignedAt  DateTime?
  qualityRepName   String?
  qualityRepUserId String?
  qualityRepUser   User?     @relation("ContainerQualityRep", fields: [qualityRepUserId], references: [id])
  qualitySignedAt  DateTime?

  // Set (with a reason) when a manifest that had already collected both
  // sign-offs above is reopened for correction -- the manifest can't be
  // edited (pallets added/removed) while both sign-offs are on file, so
  // reopening is the one explicit, logged escape hatch, not a silent bypass.
  manifestReopenedAt     DateTime?
  manifestReopenedReason String?

  // Pre-departure checklist, required before either sign-off above -- each
  // row is one manual physical confirmation (see src/lib/logistics.ts for
  // the current item list: load line, stickering, cold chain, pre-load
  // inspection). A generic keyed table rather than one field pair per item
  // so adding another checklist item is a config change, not a migration.
  checklistConfirmations ContainerChecklistConfirmation[]

  // Photo(s) of the loaded container, taken before the doors are shut --
  // required by the checklist, not optional documentation. Not cleared on
  // reopen so earlier photos stay on file as history; the checklist instead
  // requires at least one photo taken after the most recent reopen.
  loadPhotos ContainerLoadPhoto[]

  // The Certificate of Quality is gated on (lab clearance approved for every
  // lot in this container + both sign-offs above) and, once explicitly
  // approved, frozen as a permanent snapshot so later data edits (a quality
  // check correction, a lab re-classification) can't retroactively change
  // what was actually certified at the time of shipment.
  certificateApprovedAt     DateTime?
  certificateApprovedByName String?
  certificateSnapshot       Json?

  // Order.valueUsd is one lump sum for the whole order, which can span
  // several containers -- these let a specific container's own value be
  // computed exactly (by weight or by carton count) once its rate is known,
  // independent of however the rest of the order is priced.
  pricePerKgUsd     Float?
  pricePerCartonUsd Float?

  claimLines      ClaimContainerLine[]
  palletLines     ContainerPalletLine[]
  costs           ContainerCost[]
  temperatureLogs ContainerTemperatureLog[]
  specExceptions  SpecException[]
  qualityIssues   QualityIssue[]

  @@index([orderId])
}

// A named, signed record of a deliberate decision to load a pallet that fails
// one of the destination client's own spec parameters (see
// src/lib/specCompliance.ts) -- one row per (pallet, container, parameter),
// since a single pallet can be signed off on more than one violated
// parameter at once, and the same reading can pass one client's spec while
// failing a stricter one, so this can't be a single flag on the QualityCheck
// itself. Only ever created by overrideSpecExceptionAction, gated to the
// Owner or whoever holds User.isHeadOfProduction -- the whole point is a
// permanent, named trail the owner can hold that person accountable against.
model SpecException {
  id          String    @id @default(cuid())
  palletId    String
  pallet      Pallet    @relation(fields: [palletId], references: [id])
  containerId String
  container   Container @relation(fields: [containerId], references: [id])

  parameter      String // ClientSpec field key, e.g. "calyx", "brix"
  parameterLabel String // human label for display, e.g. "Calyx"
  measuredValue  String // formatted reading at time of override, e.g. "3.2 pcs/10kg"
  specLimit      String // the client's raw spec text, e.g. "2pcs/10kg"

  approvedByName    String
  approvedSignature String
  note              String?
  createdAt         DateTime @default(now())

  @@index([palletId, containerId])
}

// One row per reading taken during transit -- there's no fixed schedule (a
// forwarder might report every few hours, or only at port calls), so this is
// a log, not a handful of fixed checkpoint fields.
model ContainerTemperatureLog {
  id           String    @id @default(cuid())
  containerId  String
  container    Container @relation(fields: [containerId], references: [id])
  recordedAt   DateTime  @default(now())
  temperatureC Float
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([containerId])
}

enum ContainerCostCategory {
  DEMURRAGE
  DETENTION
  STORAGE
  CUSTOMS_DELAY
  DOCUMENTATION
  INSPECTION
  REROUTING
  OTHER
}

// Any cost beyond the base freight/booking rate -- demurrage, detention,
// storage, a customs hold, an unplanned reroute. Its own table (not a single
// field) because a shipment can rack up more than one of these over its
// transit, each on its own date, and each needs its own reason on record.
model ContainerCost {
  id          String                @id @default(cuid())
  containerId String
  container   Container             @relation(fields: [containerId], references: [id])
  category    ContainerCostCategory
  amountUsd   Float
  description String?
  incurredAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())

  @@index([containerId])
}

// How much of a given pallet's tonnage went into a given container. Normally
// a pallet appears in exactly one line at its full weight; when a container
// fills up mid-pallet, that pallet gets a second line in the next container
// for its remaining tonnage.
model ContainerPalletLine {
  id             String    @id @default(cuid())
  containerId    String
  container      Container @relation(fields: [containerId], references: [id])
  palletId       String
  pallet         Pallet    @relation(fields: [palletId], references: [id])
  quantityTonnes Float
  // Start/end of physically loading this pallet's cartons — frozen product
  // sitting in the loading bay loses temperature, so this measures how long
  // that took, not just a single "done" timestamp.
  loadingStart   DateTime?
  loadingEnd     DateTime?
  createdAt      DateTime  @default(now())

  @@index([containerId])
  @@index([palletId])
}

// Mirrors form CH08403 "Client Claim Form". One claim can span multiple
// containers (see ClaimContainerLine) — the form has a repeating per-container
// table under a single claim header.
model Claim {
  id          String        @id @default(cuid())
  claimNumber String?
  claimDate   DateTime      @default(now())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  variety     String?
  reason      ClaimReason
  severity    ClaimSeverity
  valueUsd    Float
  status      ClaimStatus   @default(OPEN)

  // Weight deduction (if claim involves a weight discrepancy)
  weightMagrabiTon    Float?
  weightClientTon     Float?
  weightDifferenceKg  Float?
  weightDifferencePct Float?

  // Pricing / contract context
  clientPrice               Float?
  shippingPricePerContainer Float?
  clientFarmGateBeforeIssue Float?
  clientFarmGateAfterIssue  Float?
  totalShippingPrice        Float?
  priceAgreement            String?
  paymentTerms              String?
  contractWithCompany       String?

  claimDetails    String?
  qualityResponse String?

  // Third-party container inspection
  inspectionCompanySent   Boolean?
  inspectionCompanyName   String?
  inspectionCompanyCost   Float?
  inspectionCompanyReport String?

  // Financial negotiation trail
  amountRequestedFromClient  Float?
  amountAfterNegotiation     Float?
  discountValue              Float?
  amountRequestedForApproval Float?
  totalShipmentValue         Float?
  discountPct                Float?

  otherNotes String?

  // Approval sign-offs
  accountManager     String?
  itManager          String?
  exportManager      String?
  exportDirector     String?
  commercialDirector String?
  chairman           String?

  resolvedDate DateTime?
  createdAt    DateTime  @default(now())

  containers  ClaimContainerLine[]
  attachments ClaimAttachment[]

  @@index([clientId])
}

// Photo of the physically loaded container, taken before the doors are shut
// -- part of the pre-departure checklist (see Container.loadPhotos), not
// optional documentation. Who uploaded it is recorded for the same reason as
// ClaimAttachment below.
model ContainerLoadPhoto {
  id               String    @id @default(cuid())
  containerId      String
  container        Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  uploadedByUserId String?
  uploadedBy       User?     @relation("ContainerLoadPhotoUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([containerId])
}

// One row per manual pre-departure checklist item a person has physically
// confirmed for a container (see CONTAINER_CHECKLIST_ITEMS in
// src/lib/logistics.ts for the current key list) -- a generic keyed table
// instead of a field pair per item so the checklist can grow without a
// schema migration each time. confirmedByUserId ties it to who was actually
// logged in, the same accountability reasoning as the sign-offs above.
model ContainerChecklistConfirmation {
  id                String    @id @default(cuid())
  containerId       String
  container         Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  itemKey           String
  confirmedAt       DateTime  @default(now())
  confirmedByName   String
  confirmedByUserId String?
  confirmedByUser   User?     @relation(fields: [confirmedByUserId], references: [id])

  @@unique([containerId, itemKey])
  @@index([containerId])
}

// Photo/document evidence attached to a claim -- who uploaded each file is
// recorded so the trail of who supplied what evidence is traceable later.
model ClaimAttachment {
  id               String   @id @default(cuid())
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  caption          String?
  uploadedByUserId String?
  uploadedBy       User?    @relation("ClaimAttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([claimId])
}

// One row per container listed in the claim's per-container table.
model ClaimContainerLine {
  id                    String     @id @default(cuid())
  claimId               String
  claim                 Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  containerNumber       String
  containerId           String?
  container             Container? @relation(fields: [containerId], references: [id])
  variety               String?
  shippingLine          String?
  cartonsPerContainer   Int?
  netWeight             Float?
  shipmentDate          DateTime?
  arrivalDate           DateTime?
  complaintDate         DateTime?
  sellingPricePerCarton Float?
  shippingPrice         Float?
  lostCartons           Int?
  creditRequired        Float?
  claimPct              Float?
  claimAmount           Float?
  totalSales            Float?

  @@index([claimId])
  @@index([containerId])
}

enum QualityIssueStatus {
  OPEN
  RESOLVED
}

// A quality problem reported (often by a client) without a financial claim
// attached -- the goal is process improvement, not compensation. Reuses
// ClaimReason since the categories (quality/packaging/foreign material/
// transport) are the same either way.
model QualityIssue {
  id               String             @id @default(cuid())
  issueDate        DateTime           @default(now())
  clientId         String?
  client           Client?            @relation(fields: [clientId], references: [id])
  variety          String?
  reason           ClaimReason
  status           QualityIssueStatus @default(OPEN)
  // Order #, container #, or lot # this relates to, if known -- kept as raw
  // text since it may reference any of several entity types, but resolved at
  // creation time against whichever table's number matches (at most one of
  // the three below, since order/container/lot numbers don't overlap) so a
  // typo is visible rather than silently unlinked.
  relatedReference   String?
  relatedOrderId     String?
  relatedOrder       Order?         @relation(fields: [relatedOrderId], references: [id])
  relatedContainerId String?
  relatedContainer   Container?     @relation(fields: [relatedContainerId], references: [id])
  relatedLotId       String?
  relatedLot         ProductionLot? @relation(fields: [relatedLotId], references: [id])

  issueDetails     String?
  rootCause        String?
  correctiveAction String?

  // Effectiveness check -- did the corrective action actually stop the
  // problem recurring? Session-identity-based like every other sign-off in
  // this app (not a typed name), and gated on rootCause + correctiveAction
  // both being on file first (see canVerifyQualityIssueCapa in actions.ts).
  verifiedByName    String?
  verifiedByUserId  String?
  verifiedByUser    User?     @relation(fields: [verifiedByUserId], references: [id])
  verifiedAt        DateTime?
  verificationNotes String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([relatedOrderId])
  @@index([relatedContainerId])
  @@index([relatedLotId])
}

model Alert {
  id                String      @id @default(cuid())
  type              AlertType
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  targetRole        Role
  status            AlertStatus @default(UNREAD)
  createdAt         DateTime    @default(now())

  @@index([targetRole, status])
}

// Digitizes the factory's existing 4-part paper/Excel "Frozen Strawberry
// Production Report" (one filed per day). Every figure here is manually
// transcribed from the real form, not derived from other app data -- the
// relationships between stages (first balance, raw incoming, rejects, etc.)
// aren't reliably computable, and this report is itself the factory's own
// manual daily reconciliation.

// Hourly instrument reading -- append-only, one row per entry, mirroring
// ContainerTemperatureLog exactly. `location` is matched in code (not the DB)
// against a fixed list carrying each location's Limits/Instrument reference,
// since that's fixed metadata, not something that varies per reading.
model DailyTemperatureLog {
  id            String   @id @default(cuid())
  factoryId     String
  factory       Factory  @relation(fields: [factoryId], references: [id])
  location      String
  recordedAt    DateTime @default(now())
  valueC        Float
  checkedByName String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([factoryId, location, recordedAt])
}

// Section I) Quantities -- one row per plant/shift/variety/day. Both the
// tonnage and % columns are transcribed as entered on the paper form.
model DailyQuantityEntry {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType
  variety   String

  firstBalanceTon Float?

  rawIncomingTon Float?
  rawIncomingPct Float?

  inletForOperationTon Float?
  inletForOperationPct Float?

  endBalanceTon Float?
  endBalancePct Float?

  firstClassWholeTon Float?
  firstClassWholePct Float?

  secondClassWholeTon Float?
  secondClassWholePct Float?

  rejectedBeforeTunnelTon Float?
  rejectedBeforeTunnelPct Float?

  rejectedAfterTunnelTon Float?
  rejectedAfterTunnelPct Float?

  totalPackedTon Float?
  totalPackedPct Float?

  // "الفاقد والمتمم الحسابي" -- lost / reconciliation difference, distinct
  // from both rejection categories. Verified against the real report: Total
  // Packed + Rejected(before) + Rejected(after) + Lost == Inlet for Operation.
  lostTon Float?
  lostPct Float?

  createdAt DateTime @default(now())

  @@index([factoryId, date])
}

// Section II) Packing -- one row per package line. clientOther covers rows
// that aren't a real sales client (e.g. lab/quality samples), matching the
// SelectWithOther dropdown-with-free-text-fallback pattern used elsewhere.
model DailyPackingLine {
  id        String   @id @default(cuid())
  date      DateTime
  factoryId String?
  factory   Factory? @relation(fields: [factoryId], references: [id])

  packageType String
  logo        String
  weightKg    Float?
  variety     String?

  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  clientOther String?

  firstClassQty   Int?
  secondClassQty  Int?
  totalPackageQty Int?
  totalTon        Float?

  createdAt DateTime @default(now())

  @@index([date])
}

// Section IV) Downtime -- one row per stoppage event, per plant/shift/day.
model DailyDowntimeEvent {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType
  reason    String
  fromTime  DateTime
  toTime    DateTime

  createdAt DateTime @default(now())

  @@index([factoryId, date])
}

// Sections III/V) Line Power & Actual Line Efficiency summary -- one row per
// plant/shift/day. Total Downtime and Actual Run Time are computed on
// display from this row's uptime window plus the linked DailyDowntimeEvent
// rows, not stored here.
model DailyLineEfficiency {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType

  uptimeFrom             DateTime?
  uptimeTo               DateTime?
  lineCapacityTonPerHour Float?
  expectedQuantityTon    Float?
  actualQuantityTon      Float?

  createdAt DateTime @default(now())

  @@unique([factoryId, date, shiftType])
}

// Which physical (or, for Operations Efficiency, coordinating) part of the
// factory a labour headcount entry belongs to -- see LABOUR_ROLE_MATRIX in
// src/lib/labour.ts for which LabourRoleType values are valid per department.
enum LabourDepartment {
  INTAKE
  INFEED
  PROCESSING
  OPERATIONS_EFFICIENCY
  QUALITY_CONTROL
  MAINTENANCE_ENGINEERING
  PACKAGING
  LOAD_OUT
  CLEANING
}

enum LabourRoleType {
  SUPERVISOR
  FORKLIFT_DRIVER
  DAILY_WORKER
}

// Headcount distribution across the factory, per shift/day -- one row per
// department+role combo actually staffed. Only combos listed in
// LABOUR_ROLE_MATRIX are ever written (e.g. Cleaning never gets a Forklift
// Driver row), so absence of a row means "not applicable here", not
// "zero and unrecorded".
//
// SUPERVISOR rows are named, not counted -- the point is knowing who was
// actually responsible for a given department on a given shift, not how
// many. FORKLIFT_DRIVER/DAILY_WORKER rows are counted, not named. Exactly
// one of headcount/supervisorName is ever set, matching which of the two a
// row's role actually calls for.
model DailyLabourEntry {
  id             String           @id @default(cuid())
  factoryId      String
  factory        Factory          @relation(fields: [factoryId], references: [id])
  date           DateTime
  shiftType      ShiftType
  department     LabourDepartment
  role           LabourRoleType
  headcount      Int?
  supervisorName String?

  createdAt DateTime @default(now())

  @@unique([factoryId, date, shiftType, department, role])
  @@index([factoryId, date])
}

// The physical areas Cleaning Mode scores, between shifts -- distinct from
// LabourDepartment (which is about who's staffed where during a shift, not
// which zones need cleaning/drying before the next one starts).
enum CleaningArea {
  ARRIVAL
  PRE_COOLING
  PROCESSING
  PACKAGING
  COLD_STORES_AND_CORRIDORS
  LOAD_OUT
  DRY_STORAGE_ROOMS
}

// One row per factory/date/shift/area -- each responsible head scores every
// area independently, 0-10. Not cleared when the shift record is reopened
// (see CleaningShiftRecord): correcting one area's score doesn't invalidate
// the others, only the sign-offs need re-collecting.
model CleaningAreaScore {
  id               String       @id @default(cuid())
  factoryId        String
  factory          Factory      @relation(fields: [factoryId], references: [id])
  date             DateTime
  shiftType        ShiftType
  area             CleaningArea
  productionScore  Int?
  maintenanceScore Int?

  createdAt DateTime @default(now())

  @@unique([factoryId, date, shiftType, area])
  @@index([factoryId, date])
}

// One row per factory/date/shift -- whether the foam washer was used this
// round (it isn't every shift, so this is what lets the scores be read
// against actual cleaning method over time), and the two required
// sign-offs before the next shift can start. Locked (like a container
// manifest) once both sign-offs are on file; reopening clears both
// sign-offs and requires a reason, since signing means "I've reviewed and
// scored every area" -- area scores themselves aren't touched by a reopen.
model CleaningShiftRecord {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType

  cleanedWithFoam Boolean @default(false)

  productionSignedByName   String?
  productionSignedByUserId String?
  productionSignedByUser   User?     @relation("CleaningProductionSignOff", fields: [productionSignedByUserId], references: [id])
  productionSignedAt       DateTime?

  maintenanceSignedByName   String?
  maintenanceSignedByUserId String?
  maintenanceSignedByUser   User?     @relation("CleaningMaintenanceSignOff", fields: [maintenanceSignedByUserId], references: [id])
  maintenanceSignedAt       DateTime?

  reopenedAt     DateTime?
  reopenedReason String?

  createdAt DateTime @default(now())

  @@unique([factoryId, date, shiftType])
}

// The Head of Production's per-shift plant walkthrough (arrivals, pre-
// cooling, production, packaging, cold stores, loading, warehouse, services
// areas -- see DAILY_CHECKLIST_SECTIONS in src/lib/dailyChecklist.ts for the
// actual item text). One row per factory/date/shift/item, holding a 0-10
// score for that item -- presence of a row means it's been scored on that
// walkthrough. Unlike Cleaning Mode, this has no sign-off/lock -- it's
// routine daily scoring, freely re-editable, not a one-time accountability
// gate.
model DailyProductionChecklistScore {
  id            String    @id @default(cuid())
  factoryId     String
  factory       Factory   @relation(fields: [factoryId], references: [id])
  date          DateTime
  shiftType     ShiftType
  itemKey       String
  score         Int
  scoredByName  String
  scoredByUserId String?
  scoredByUser  User?     @relation(fields: [scoredByUserId], references: [id])
  scoredAt      DateTime  @default(now())

  @@unique([factoryId, date, shiftType, itemKey])
  @@index([factoryId, date, shiftType])
}

// Decap has no dedicated Factory/ShiftLog entity of its own (it exists only
// implicitly via the PRE_DECAP/POST_DECAP QualityCheckpoint values), so this
// is a plain one-row-per-day log rather than something tied to a factory or
// shift. Weight In is deliberately NOT stored here -- it's always computed
// live from HarvestTicket.netWeightKg (already captured at the decap receipt
// step), so there's no second copy of that number to drift out of sync.
model DecapDailyLog {
  id          String   @id @default(cuid())
  date        DateTime @unique
  weightOutKg Float?
  calyxKg     Float?
  createdAt   DateTime @default(now())
}

// Named-individual training log for supervisors. supervisorName is free text
// rather than a User relation -- most floor supervisors (e.g. the person
// named on a DailyLabourEntry) have no app login at all, so tying this to
// User would silently drop everyone except the handful of office accounts.
// trainingType is free text for now: the Owner is supplying the real list of
// training types after this skeleton ships, so it isn't hardcoded yet.
enum StaffTrainingTier {
  SUPERVISOR
  WORKER
}

// Originally split into a named-supervisor model and a department-aggregate
// model for workers, since the app had no individual identity for daily
// workers at all. Unified into one model once the Owner supplied TRA03 --
// a real historical training register with named attendance for every
// employee, workers included -- since aggregating that down to headcounts
// would have thrown away real, already-available names.
model StaffTrainingRecord {
  id           String            @id @default(cuid())
  tier         StaffTrainingTier
  attendeeName String
  jobTitle     String?
  gender       String?
  trainingType String
  trainedDate  DateTime
  expiryDate   DateTime?
  provider     String?
  trainerName  String?
  notes        String?

  recordedByUserId String?
  recordedByUser    User?  @relation(fields: [recordedByUserId], references: [id])
  createdAt         DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([attendeeName])
  @@index([trainingType])
}

// CAL03607 -- one sealed carton is passed through the packaging-room metal
// detector before palletisation. Sensitivity is verified before shift start,
// hourly, at end of shift, on product change, and after a break by passing
// three test packages (Ferrous/Non-Ferrous/Stainless steel test pieces) through
// the opening and confirming the machine detects each.
model MetalDetectorCheck {
  id            String    @id @default(cuid())
  factoryId     String
  factory       Factory   @relation(fields: [factoryId], references: [id])
  date          DateTime
  shiftType     ShiftType
  recordedAt    DateTime  @default(now())
  equipmentNumber   String?
  traceabilityCode  String?

  ferrousDetected       Boolean?
  ferrousDiameterMm     Float?
  nonFerrousDetected    Boolean?
  nonFerrousDiameterMm  Float?
  stainlessDetected     Boolean?
  stainlessDiameterMm   Float?

  // False here means the carton was held, not released -- correctiveAction
  // is required in that case (mirrors the paper form's own logic).
  productReleased  Boolean?
  correctiveAction String?

  checkedByName   String?
  checkedByUserId String?
  checkedByUser   User?   @relation("MetalDetectorCheckedBy", fields: [checkedByUserId], references: [id])
  createdAt       DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([factoryId, date, shiftType])
}

// The other half of CAL03607 -- a once-per-shift maintenance checklist,
// separate from the hourly detection checks above (own signature, own
// cadence: once per shift, not hourly).
model MetalDetectorMaintenanceCheck {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType

  sensitivityCheckedThreeSides Boolean?
  alarmCheckedAudioVisual      Boolean?
  electricalPanelChecked       Boolean?
  beltRollersCleanChecked      Boolean?

  checkedByName   String?
  checkedByUserId String?
  checkedByUser   User?    @relation("MetalDetectorMaintenanceCheckedBy", fields: [checkedByUserId], references: [id])
  createdAt       DateTime @default(now())

  reopenedAt     DateTime?
  reopenedReason String?

  isTestData Boolean @default(false)

  @@unique([factoryId, date, shiftType])
}

// STR03117 -- free chlorine dosed into the wash tanks (disinfecting the
// strawberries during washing at the IQF factory). Verifies the hourly
// manual reading against the dosing machine's set point/standard rate --
// deviationOccurred is the checker's own call, matching the paper form
// (not computed against a stored target, since the form doesn't record one).
enum DosingAgent {
  CHLORINE
  PERACETIC_ACID
  OTHER
}

model ChlorineDosingCheck {
  id        String    @id @default(cuid())
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType
  recordedAt DateTime @default(now())

  // The dosing pump doses either chlorine or peracetic acid depending on
  // what's loaded -- OTHER + dosingAgentOther covers anything else, same
  // "select from the common cases, free text for the rest" convention as
  // DailyPackingLine.clientOther.
  dosingAgent      DosingAgent @default(CHLORINE)
  dosingAgentOther String?

  phLevel            Float?
  freeChlorinePpm    Float?
  fruitTransitSeconds Float?

  deviationOccurred Boolean?
  correctiveAction  String?

  verifiedOk      Boolean?
  verifiedByName  String?
  verifiedByUserId String?
  verifiedByUser  User?   @relation("ChlorineDosingVerifiedBy", fields: [verifiedByUserId], references: [id])
  createdAt       DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([factoryId, date, shiftType])
}

// HSE03296 -- daily uniform laundry register for the shared washroom serving
// both packhouses (Factory codes 11/13). One row per worker per day whose
// garment pieces were exchanged/laundered that day; each garment's value is
// its piece number from the laundry's monthly register, not a count.
model LaundryRecord {
  id        String   @id @default(cuid())
  date      DateTime
  packhouse String   @default("PKH 11,13")

  workerName String

  whiteCoatNo          String?
  whiteTrousersNo      String?
  blueCoatNo           String?
  visitorCoatNo        String?
  maintenanceOverallNo String?
  yellowCoatNo         String?
  greenCoatNo          String?
  yellowSuitNo         String?
  coldStoreSuitNo      String?
  greyJacketNo         String?
  blackJacketNo        String?
  glovesNo             String?
  whiteHeadscarfNo     String?
  towelNo              String?
  capNo                String?
  blueSuitNo           String?

  comments String?

  recordedByName   String?
  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([date])
  @@index([workerName])
}

// HSE03293 -- one row per batch/load washed at the same laundry room, with
// its washing parameters. Distinct from LaundryRecord (which garment piece
// went to which worker) -- this is the wash cycle itself.
model LaundryWashCycle {
  id       String   @id @default(cuid())
  date     DateTime
  location String   @default("PKH 11,13")

  itemType String
  count    Int?
  purpose  String?

  waterTemperatureC Float?
  agent             String?
  concentration     String?
  timeFrom          String?
  timeTo            String?
  amountOfAgent     String?
  dryerTemperatureC Float?

  recordedByName   String?
  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([date, location])
}

// HSE03293's end-of-day sign-off -- one per date+location, separate from the
// wash-cycle rows above (own cadence: once per day, not once per load).
// Mirrors CleaningShiftRecord's two-different-people sign-off pattern.
model LaundryDailySignOff {
  id       String   @id @default(cuid())
  date     DateTime
  location String   @default("PKH 11,13")

  notes                 String?
  cleanlinessAcceptable Boolean?

  supervisorSignedByName   String?
  supervisorSignedByUserId String?
  supervisorSignedByUser   User?     @relation("LaundrySignOffSupervisor", fields: [supervisorSignedByUserId], references: [id])
  supervisorSignedAt       DateTime?

  verifiedSignedByName   String?
  verifiedSignedByUserId String?
  verifiedSignedByUser   User?     @relation("LaundrySignOffVerifiedBy", fields: [verifiedSignedByUserId], references: [id])
  verifiedSignedAt       DateTime?

  reopenedAt     DateTime?
  reopenedReason String?

  createdAt DateTime @default(now())

  isTestData Boolean @default(false)

  @@unique([date, location])
}

// HSE03297 (Packhouse 11) / HSE03312 (Packhouse 13) -- the master sanitation
// schedule, distinct from CleaningShiftRecord/CleaningAreaScore's 0-10
// quality score. This tracks whether a specific scheduled task (of ~280,
// spanning ~19 zones, each with its own tools/chemical/frequency) was
// actually performed on a given day. taskKey matches a key in the static
// MASTER_CLEANING_TASKS config in src/lib/masterCleaningSchedule.ts -- the
// two packhouses share one task list (their schedules are near-identical),
// logged separately per factory.
model MasterCleaningTaskLog {
  id        String   @id @default(cuid())
  factoryId String
  factory   Factory  @relation(fields: [factoryId], references: [id])
  date      DateTime
  taskKey   String

  completed         Boolean  @default(true)
  completedByName   String?
  completedByUserId String?
  completedByUser   User?    @relation(fields: [completedByUserId], references: [id])
  completedAt       DateTime @default(now())

  isTestData Boolean @default(false)

  @@unique([factoryId, date, taskKey])
  @@index([factoryId, date])
}

// A factory's request for anything it needs (cleaning materials, equipment,
// spare parts) tracked from request through to confirmed-working. Production
// requests it; Purchasing (Owner or whoever holds isHeadOfPurchasing)
// approves/rejects, then orders and tracks delivery to the farm gate;
// Production then confirms it actually arrived, and separately confirms it
// works -- "delivered" and "works" are deliberately two different facts,
// since a piece of equipment can arrive damaged or wrong.
model PurchaseRequest {
  id              String           @id @default(cuid())
  factoryId       String
  factory         Factory          @relation(fields: [factoryId], references: [id])

  status PurchaseRequestStatus @default(REQUESTED)

  requestedByName   String
  requestedByUserId String?
  requestedByUser   User?    @relation("PurchaseRequestedBy", fields: [requestedByUserId], references: [id])
  requestedAt       DateTime @default(now())

  // The on-site warehouse is checked before Accounting or Purchasing ever
  // sees this -- null means not checked yet, true short-circuits to
  // FULFILLED_FROM_WAREHOUSE, false flips to FORWARDED_TO_ACCOUNTING. See
  // the Release Order form (STO 02406) this mirrors.
  warehouseAvailable     Boolean?
  warehouseCheckedByName String?
  warehouseCheckedByUserId String?
  warehouseCheckedByUser   User?   @relation("PurchaseWarehouseCheckedBy", fields: [warehouseCheckedByUserId], references: [id])
  warehouseCheckedAt      DateTime?

  // Accounting is the sole approve/reject decision -- the warehouse forwards
  // straight to them (not Purchasing) when nothing's in stock. Approving
  // flips status to APPROVED, at which point Purchasing takes over below.
  accountingApprovedByName   String?
  accountingApprovedByUserId String?
  accountingApprovedByUser   User?     @relation("PurchaseAccountingApprovedBy", fields: [accountingApprovedByUserId], references: [id])
  accountingApprovedAt       DateTime?
  accountingRejectionReason  String?

  // A required, separate click from actually placing the order below -- the
  // owner specifically wanted confirmation Purchasing has seen the
  // Accounting-approved request, independent of whether/when they order it.
  purchasingAcknowledgedByName   String?
  purchasingAcknowledgedByUserId String?
  purchasingAcknowledgedByUser   User?     @relation("PurchaseAcknowledgedBy", fields: [purchasingAcknowledgedByUserId], references: [id])
  purchasingAcknowledgedAt       DateTime?

  supplierName         String?
  orderReference        String?
  costUsd               Float?
  expectedDeliveryDate  DateTime?
  orderedByUserId       String?
  orderedByUser         User?     @relation("PurchaseOrderedBy", fields: [orderedByUserId], references: [id])
  orderedAt             DateTime?

  // Recorded against the same expectedDeliveryDate rather than overwriting
  // it, so the original commitment stays visible alongside how late it
  // actually ran -- checked by PURCHASE_REQUEST_OVERDUE (src/lib/alerts.ts).
  revisedDeliveryDate DateTime?
  delayReason         String?

  receivedByName   String?
  receivedByUserId String?
  receivedByUser   User?     @relation("PurchaseReceivedBy", fields: [receivedByUserId], references: [id])
  receivedAt       DateTime?

  workingConfirmedByName   String?
  workingConfirmedByUserId String?
  workingConfirmedByUser   User?     @relation("PurchaseWorkingConfirmedBy", fields: [workingConfirmedByUserId], references: [id])
  workingConfirmedAt       DateTime?
  workingNotes             String?

  photos PurchaseRequestPhoto[]
  items  PurchaseRequestItem[]

  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([factoryId])
  @@index([status])
}

// One row per item on the request -- category/description/quantity/reason
// live here so several items can be requested together as one list, with
// the whole list moving through the Requested/Approved/Ordered/Received/
// ConfirmedWorking pipeline above as a single unit (the owner's explicit
// call: items entered together are not independently approved/ordered).
model PurchaseRequestItem {
  id                String           @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  category          PurchaseCategory
  itemDescription   String
  quantity          String?
  reason            String?
  createdAt         DateTime         @default(now())

  @@index([purchaseRequestId])
}

model PurchaseRequestPhoto {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  fileName          String
  originalName      String
  caption           String?
  uploadedByUserId  String?
  uploadedBy        User?           @relation("PurchaseRequestPhotoUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId])
}

// A physical defect in the factory itself (damaged floor, leaking roof,
// etc.), tracked from report through to fix -- distinct from a
// PurchaseRequest (this is "something is broken/damaged," not "we need to
// buy something," though a repair might end up needing one). Head of
// Production reports what he sees; Head of Maintenance confirms it's real
// and commits to a plan + completion date; the point of storing that date is
// to catch maintenance-caused delays (see isStructuralIssueOverdue in
// src/lib/structuralIssues.ts), not just to record when it got fixed.
model StructuralIssue {
  id          String @id @default(cuid())
  factoryId   String
  factory     Factory @relation(fields: [factoryId], references: [id])
  location    String
  description String

  status StructuralIssueStatus @default(REPORTED)

  reportedByName   String
  reportedByUserId String?
  reportedByUser   User?    @relation("StructuralIssueReportedBy", fields: [reportedByUserId], references: [id])
  reportedAt       DateTime @default(now())

  // A lightweight "Maintenance has seen this" signal, separate from and
  // earlier than confirming the damage and committing to a repair plan --
  // the plan can take time to work out, but the reporter shouldn't have to
  // wonder whether the report reached anyone in the meantime.
  acknowledgedByName   String?
  acknowledgedByUserId String?
  acknowledgedByUser   User?     @relation("StructuralIssueAcknowledgedBy", fields: [acknowledgedByUserId], references: [id])
  acknowledgedAt       DateTime?

  confirmedByName        String?
  confirmedByUserId      String?
  confirmedByUser        User?     @relation("StructuralIssueConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt            DateTime?
  proposedPlan           String?
  proposedCompletionDate DateTime?

  completedByName   String?
  completedByUserId String?
  completedByUser   User?     @relation("StructuralIssueCompletedBy", fields: [completedByUserId], references: [id])
  completedAt       DateTime?
  completionNotes   String?

  photos StructuralIssuePhoto[]

  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([factoryId])
  @@index([status])
}

model StructuralIssuePhoto {
  id                String          @id @default(cuid())
  structuralIssueId String
  structuralIssue   StructuralIssue @relation(fields: [structuralIssueId], references: [id], onDelete: Cascade)
  fileName          String
  originalName      String
  caption           String?
  uploadedByUserId  String?
  uploadedBy        User?           @relation("StructuralIssuePhotoUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([structuralIssueId])
}

// Which named employees, by job/station, are allowed to carry a phone/pen/
// calculator/stapler in the packhouse (HSE03290/91) -- Owner or Quality
// manages this list; isActive rather than deleting so shift-check history
// stays linked to a real name even after someone's authorization is revoked.
model PersonalItemAuthorization {
  id               String   @id @default(cuid())
  name             String
  job              String?
  location         String?
  allowsMobile     Boolean  @default(false)
  allowsPens       Boolean  @default(false)
  allowsCalculator Boolean  @default(false)
  allowsOther      Boolean  @default(false)
  otherNote        String?
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  checks PersonalItemShiftCheck[]
}

// One row per authorized person per shift -- created at check-in (item
// confirmed present), completed at check-out (item confirmed returned).
// Same open-then-close pattern as ShiftLog.endTime: checkedOutAt starts
// null and is only ever filled in, never overwritten.
// HSE03291's condition codes -- 1=Intact, 2=Cracked, 3=Broken, 4=Lost. A
// Broken/Lost reading is exactly when HSE03291 says to file a GEN03108
// non-conformance report (see the standalone Non-Conformance Report page).
enum PersonalItemCondition {
  INTACT
  CRACKED
  BROKEN
  LOST
}

model PersonalItemShiftCheck {
  id              String                    @id @default(cuid())
  authorizationId String
  authorization   PersonalItemAuthorization @relation(fields: [authorizationId], references: [id])
  factoryId       String
  factory         Factory                   @relation(fields: [factoryId], references: [id])
  date            DateTime
  shiftType       ShiftType

  checkedInAt       DateTime @default(now())
  checkedInByName   String
  checkedInByUserId String?
  checkedInByUser   User?    @relation("PersonalItemCheckedInBy", fields: [checkedInByUserId], references: [id])

  // Condition at start of work, per item type -- only the ones the person
  // is actually authorized for get filled in (see PersonalItemAuthorization
  // .allowsX). Combines HSE03291's condition tracking into the same
  // check-in/check-out row this page already had, rather than a second
  // parallel record -- one sheet gives you everything both forms did.
  mobileStatusStart     PersonalItemCondition?
  pensStatusStart       PersonalItemCondition?
  calculatorStatusStart PersonalItemCondition?
  otherStatusStart      PersonalItemCondition?

  checkedOutAt       DateTime?
  checkedOutByName   String?
  checkedOutByUserId String?
  checkedOutByUser   User?     @relation("PersonalItemCheckedOutBy", fields: [checkedOutByUserId], references: [id])

  mobileStatusEnd     PersonalItemCondition?
  pensStatusEnd       PersonalItemCondition?
  calculatorStatusEnd PersonalItemCondition?
  otherStatusEnd      PersonalItemCondition?

  actionTaken String?
  notes       String?

  @@unique([authorizationId, factoryId, date, shiftType])
  @@index([factoryId, date, shiftType])
}

// The pre-high-care-area screening log (HSE03290/91-adjacent) -- catching a
// banned item (glass, jewelry, loose plastic) on someone before they enter,
// not the authorized-item custody tracked above. Deliberately a separate
// model: PersonalItemShiftCheck is keyed to a fixed roster of named,
// pre-authorized people with condition-in/condition-out state; this is an
// unbounded, timestamped incident log with no roster relationship at all.
model BannedItemScreeningRecord {
  id             String   @id @default(cuid())
  factoryId      String
  factory        Factory  @relation(fields: [factoryId], references: [id])
  date           DateTime
  personName     String
  itemFound      String
  disposalMethod String?
  location       String?
  supervisorName String

  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([factoryId, date])
}

// The month-level facts on HSE03203's header -- who runs the first-aid box,
// the blue plaster lot number (passed through the metal detector so a torn
// piece stays detectable), and the month's opening stock. Created/edited via
// upsert on first save, same as LaundryDailySignOff's header fields.
model MonthlyFirstAidSupplyLog {
  id                        String   @id @default(cuid())
  factoryId                 String
  factory                   Factory  @relation(fields: [factoryId], references: [id])
  month                     Int
  year                      Int
  supervisorName            String?
  alternateSupervisorName   String?
  bluePlasterLotNumber      String?
  bluePlasterOpeningBalance Int?
  glovesOpeningBalance      Int?
  createdAt                 DateTime @default(now())

  @@unique([factoryId, month, year])
}

// One row per injury. Blue plaster/glove "current balance" is deliberately
// not stored -- it's derived from the month's opening balance minus the
// running total of itemsReleased across rows in order (see injuryLog.ts),
// same reasoning as isStructuralIssueOverdue: a typed balance can drift from
// reality, a computed one can't.
model InjuryRecord {
  id                  String   @id @default(cuid())
  factoryId           String
  factory             Factory  @relation(fields: [factoryId], references: [id])
  date                DateTime
  employeeName        String
  packingGroupNumber  String?
  injuryDescription   String
  occurredInWork      Boolean
  sickLeaveDays       Int?
  returnToWorkDate    DateTime?
  referredToPhysician Boolean  @default(false)

  bluePlasterReleaseTime   String?
  bluePlasterItemsReleased Int?
  glovesReleaseTime        String?
  glovesItemsReleased      Int?

  endOfDayConfirmed     Boolean @default(false)
  endOfDayConfirmedTime String?
  correctiveAction      String?
  firstAidSupervisorSignature String?

  recordedByUserId String?
  recordedByUser   User?   @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([factoryId, date])
}

// Part 1 of HSE03210 -- a machine's built-in blade, checked for a sound
// (intact) blade at installation and at end of operation, washed/sanitized
// an open-ended number of times through the shift (see BladeWashEvent) --
// not a fixed hourly grid, since wash timing isn't tied to the clock.
model BladeEquipmentCheck {
  id                     String   @id @default(cuid())
  factoryId              String
  factory                Factory  @relation(fields: [factoryId], references: [id])
  date                   DateTime
  shiftType              ShiftType
  equipmentName          String
  bladeType              String?
  replaceableBladeCount  Int?
  soundAtInstallation    Boolean  @default(false)
  soundAtEndOfOperation  Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())

  washEvents BladeWashEvent[]

  @@index([factoryId, date])
}

model BladeWashEvent {
  id                    String              @id @default(cuid())
  equipmentCheckId      String
  equipmentCheck        BladeEquipmentCheck @relation(fields: [equipmentCheckId], references: [id], onDelete: Cascade)
  recordedAt            DateTime            @default(now())

  @@index([equipmentCheckId])
}

// Part 2 -- a numbered knife issued to a worker at shift start, and the same
// number must come back at shift end (piece count checked too). Same
// open-then-close pattern as ShiftLog.endTime / PersonalItemShiftCheck:
// returnedAt starts null, filled in once, never overwritten. A mismatched
// receipt number or missing piece is exactly the gap Part 3 exists to catch.
enum BladeReturnCondition {
  INTACT
  DAMAGED
  PIECE_MISSING
}

model BladeIssueRecord {
  id                 String    @id @default(cuid())
  factoryId          String
  factory            Factory   @relation(fields: [factoryId], references: [id])
  date               DateTime
  shiftType          ShiftType
  workerName         String
  packingGroupNumber String?

  issuedAt         DateTime @default(now())
  issueKnifeNumber String

  returnedAt         DateTime?
  receiptKnifeNumber String?
  pieceCount         Int?
  // Recorded at the same moment as the return -- whether the knife itself
  // came back damaged or missing a piece, independent of whether its number
  // matched (receiptKnifeNumber above). Anything other than Intact raises
  // an alert immediately, same reasoning as the number-mismatch case.
  returnCondition    BladeReturnCondition?
  notes              String?

  createdAt DateTime @default(now())

  @@index([factoryId, date])
}

// Part 3 -- reporting a broken blade or a missing replaceable piece, from
// either a hand knife (Part 2) or a machine (Part 1). reportedByName is free
// text, not session-derived -- the reporter is often a line worker with no
// app login (same reasoning as StaffTrainingRecord.supervisorName).
model BladeIncidentReport {
  id               String   @id @default(cuid())
  factoryId        String
  factory          Factory  @relation(fields: [factoryId], references: [id])
  date             DateTime
  reportedAt       DateTime @default(now())
  reportedByName   String
  report           String
  relatedReference String?
  correctiveAction String?
  createdAt        DateTime @default(now())

  @@index([factoryId, date])
}

// STO02421 -- the day-level header (what's being packed, who signed).
// Created/edited via upsert on first save, same as MonthlyFirstAidSupplyLog.
// storeName is STO02408's separate "store name" header field -- the specific
// storage room/warehouse, which can differ from the factory/farm itself.
model PackagingMaterialsDailyLog {
  id                     String   @id @default(cuid())
  factoryId              String
  factory                Factory  @relation(fields: [factoryId], references: [id])
  date                   DateTime
  finalProduct           String?
  storeName              String?
  packhouseManagerName   String?
  storeSupervisorName    String?
  createdAt              DateTime @default(now())

  items PackagingMaterialItem[]

  @@unique([factoryId, date])
}

// The canonical material catalog -- one row per material per factory, with
// the real reorder threshold and (optionally) how much of it a tonne of
// packed product consumes. Replaces re-typing name/code/unit/min/max on
// every daily row: PackagingMaterialItem.itemName stays a denormalized
// snapshot for display, but materialId is the source of truth going forward.
model PackagingMaterial {
  id            String   @id @default(cuid())
  factoryId     String
  factory       Factory  @relation(fields: [factoryId], references: [id])
  name          String
  code          String?
  unit          String?
  minStockLevel Float?
  // Quantity of `unit` consumed per tonne of product packed (matched against
  // DailyQuantityEntry.totalPackedTon, summed across shifts/varieties for a
  // given factory+date) -- lets the low-stock check project days-of-stock
  // remaining from actual output instead of only a static floor.
  consumptionRatioPerTon Float?
  // These two drive automatic stock deduction the moment a pallet is packed
  // (see recordPackagingConsumptionForPallet, called from
  // final-product-entry/actions.ts) -- a separate mechanism from
  // consumptionRatioPerTon above, which only feeds the low-stock *warning*
  // projection and never writes anything. quantityPerCarton scales with the
  // pallet's actual totalCartons (cartons, inner bags -- a partial pallet
  // rightly consumes fewer of these); quantityPerPallet is a fixed amount
  // per pallet regardless of fill level (corners, clips, straps, pallet
  // cover, the pallet itself -- a half-full pallet still needs its own
  // single pallet base, cover, and set of corners).
  quantityPerCarton Float?
  quantityPerPallet Float?
  notes         String?
  isTestData    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PackagingMaterialItem[]

  @@unique([factoryId, name])
}

// One row per item per day -- combines STO02421's daily reconciliation
// (opening/used/damaged/closing) with STO02408's stock-card fields (code,
// unit, min/max level, expiry, storage location, receipt/voucher #, supply
// or issue destination, store keeper) so one sheet carries everything both
// forms did. Closing balance is deliberately not stored, it's opening plus
// received minus used minus damaged (see packagingMaterials.ts), same
// "derived, not typed" reasoning as isStructuralIssueOverdue. itemName stays
// a denormalized snapshot of the material's name at entry time; materialId
// links back to the canonical PackagingMaterial (nullable so pre-catalog
// historical rows still render).
model PackagingMaterialItem {
  id                      String                     @id @default(cuid())
  dailyLogId              String
  dailyLog                PackagingMaterialsDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  materialId              String?
  material                PackagingMaterial?         @relation(fields: [materialId], references: [id])
  itemName                String
  productCode             String?
  productUnit             String?
  minLevel                Int?
  maxLevel                Int?
  openingBalance          Int?
  quantityReceived        Int?
  quantityUsed            Int?
  quantityDamaged         Int?
  receiptOrVoucherNumber  String?
  supplyOrIssueDestination String?
  expiryDate              DateTime?
  storageLocation         String?
  lotNumber               String?
  storeKeeperName         String?
  createdAt               DateTime                   @default(now())

  @@index([dailyLogId])
  @@index([materialId])
}

// A flat daily consumption log -- how much of which cleaning chemical was
// used today, at what concentration, and for what. Deliberately not shaped
// like PackagingMaterialsDailyLog/PackagingMaterialItem above: that
// header+child shape exists specifically for opening/received/used/damaged/
// closing stock reconciliation, which nothing here calls for -- this is
// just "we used X of Y today," one row per material per day.
model CleaningMaterialConsumptionRecord {
  id             String   @id @default(cuid())
  factoryId      String
  factory        Factory  @relation(fields: [factoryId], references: [id])
  date           DateTime
  materialName   String
  quantityUsed   Float
  unit           String?
  concentration  String?
  purpose        String?
  recordedByName String

  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now())

  isTestData Boolean @default(false)

  @@index([factoryId, date])
}

enum ForkliftEquipmentType {
  DIESEL_CLARK
  ELECTRIC_CLARK
  POWER_PALLET
}

// HSE03298 -- one sheet per piece of equipment, registering its glass/
// plastic part count so daily checks below know what they're inspecting for
// (a food-safety concern: a broken glass/plastic fragment falling into
// product).
model ForkliftEquipment {
  id                            String                @id @default(cuid())
  factoryId                     String
  factory                       Factory               @relation(fields: [factoryId], references: [id])
  equipmentType                 ForkliftEquipmentType
  equipmentNumber                String
  glassPlasticPartsCount         Int?
  glassPlasticPartsDescription   String?
  createdAt                      DateTime              @default(now())

  checks ForkliftConditionCheck[]

  @@unique([factoryId, equipmentNumber])
}

// One row per equipment per day -- glass/plastic condition, cleaning
// materials/concentration used, and who cleaned vs. who verified (two
// different people, matching the printed form's two signature columns).
model ForkliftConditionCheck {
  id                    String            @id @default(cuid())
  equipmentId           String
  equipment             ForkliftEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date                  DateTime
  glassPlasticIntact    Boolean
  cleaningMaterialsUsed String?
  concentrationUsed     String?
  cleanedByName         String?
  checkedByName         String?
  notes                 String?
  createdAt             DateTime          @default(now())

  @@unique([equipmentId, date])
}

// GEN03108 -- the general-purpose escalation form. Deliberately separate
// from Quality Issues / Blade Incident Report / Structural Issues (each of
// those stays its own domain-specific record); this is the company-wide
// non-conformance mechanism other forms point to when something needs
// formal root-cause + CAPA tracking outside of a specific workflow.
enum NonConformanceType {
  PRODUCT
  PROCESS
  EQUIPMENT
  DOCUMENTATION
  SUPPLIER
  OTHER
}

enum NonConformanceSource {
  INTERNAL_AUDIT
  EXTERNAL_AUDIT
  CUSTOMER_COMPLAINT
  INSPECTION
  STAFF_REPORT
  OTHER
}

model NonConformanceReport {
  id        String  @id @default(cuid())
  factoryId String
  factory   Factory @relation(fields: [factoryId], references: [id])

  date               DateTime
  location           String
  productOrReference String?
  ncType             NonConformanceType
  source             NonConformanceSource
  description        String

  reportedByName   String
  reportedByUserId String?
  reportedByUser   User?    @relation("NonConformanceReportedBy", fields: [reportedByUserId], references: [id])
  reportedAt       DateTime @default(now())

  // CAPA fields -- same shape as Quality Issues' root-cause/verification
  // skeleton (src/app/(app)/quality-issues/actions.ts), reused here rather
  // than reinvented.
  rootCause        String?
  correctiveAction String?
  preventiveAction String?

  verifiedByName    String?
  verifiedByUserId  String?
  verifiedByUser    User?     @relation("NonConformanceVerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedAt        DateTime?
  verificationNotes String?

  photos NonConformanceReportPhoto[]

  // Set when this report was raised from a client audit finding (Visits),
  // rather than created directly -- optional, most NCs have no visit origin.
  raisedFromAuditFindings ClientAuditFinding[]

  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([factoryId])
  @@index([ncType])
}

model NonConformanceReportPhoto {
  id                     String               @id @default(cuid())
  nonConformanceReportId String
  nonConformanceReport   NonConformanceReport @relation(fields: [nonConformanceReportId], references: [id], onDelete: Cascade)
  fileName               String
  originalName           String
  caption                String?
  uploadedByUserId       String?
  uploadedBy             User?                @relation("NonConformanceReportPhotoUploadedBy", fields: [uploadedByUserId], references: [id])
  createdAt              DateTime             @default(now())

  @@index([nonConformanceReportId])
}

// CAL03602 -- one scale registered per physical device (target weight,
// sensitivity, and its own max permissible error tolerance), checked once a
// day against a reference weight. Deviation is stored as a signed value in
// grams; a check is "in tolerance" whenever its absolute value doesn't
// exceed the scale's own maxPermissibleErrorG -- computed at read time
// rather than stored, so a scale's tolerance can be corrected later without
// having to rewrite every past check's pass/fail state.
model WeighingScale {
  id                   String   @id @default(cuid())
  factoryId            String
  factory              Factory  @relation(fields: [factoryId], references: [id])
  scaleNumber          String
  location             String?
  targetWeightKg       Float
  sensitivity          String?
  refValueKg           Float?
  maxPermissibleErrorG Float
  createdAt            DateTime @default(now())

  checks ScaleCalibrationCheck[]

  @@unique([factoryId, scaleNumber])
}

model ScaleCalibrationCheck {
  id             String        @id @default(cuid())
  scaleId        String
  scale          WeighingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  date           DateTime
  deviationG     Float         @default(0)
  verifiedByName String?
  notes          String?
  createdAt      DateTime      @default(now())

  @@unique([scaleId, date])
}

// HSE03299 -- a station's shared tool count (crates, shovels, ladders,
// storage boxes...), checked at both ends of a shift rather than once a
// day: a piece going missing or breaking mid-shift is exactly what this
// exists to catch, same reasoning as the hand-knife issue/return
// accountability in Blade Control. Counts, not a single condition value,
// since a "tool" here is really a registered quantity of one item type, not
// one single physical unit like a phone in Personal Items.
model ToolInventoryItem {
  id        String   @id @default(cuid())
  name      String
  count     Int
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  checks ToolInventoryShiftCheck[]
}

model ToolInventoryShiftCheck {
  id        String    @id @default(cuid())
  toolId    String
  tool      ToolInventoryItem @relation(fields: [toolId], references: [id])
  factoryId String
  factory   Factory   @relation(fields: [factoryId], references: [id])
  date      DateTime
  shiftType ShiftType

  checkedInAt       DateTime @default(now())
  checkedInByName   String
  checkedInByUserId String?
  checkedInByUser   User?    @relation("ToolInventoryCheckedInBy", fields: [checkedInByUserId], references: [id])
  startIntactCount  Int?
  startBrokenCount  Int?

  checkedOutAt       DateTime?
  checkedOutByName   String?
  checkedOutByUserId String?
  checkedOutByUser   User?     @relation("ToolInventoryCheckedOutBy", fields: [checkedOutByUserId], references: [id])
  endIntactCount     Int?
  endBrokenCount     Int?
  notes              String?

  @@unique([toolId, factoryId, date, shiftType])
}

// HSE03207 / HSE03228 -- per-instrument pest control, replacing a single
// weekly pass/fail checkbox (Cleaning Schedule's "Light Traps" /
// "Rodent Bait Stations" tasks, which still track that the round happened)
// with the actual per-trap counts and condition codes the printed forms
// collect. Both registers share the same condition vocabulary in the
// printed form (intact/wet/spoiled/missing/broken/displaced/live or dead
// rodent found/good/not good), so one status enum covers bait stations and
// glue traps alike rather than inventing two overlapping ones.
model LightTrap {
  id         String   @id @default(cuid())
  factoryId  String
  factory    Factory  @relation(fields: [factoryId], references: [id])
  trapNumber String
  location   String?
  createdAt  DateTime @default(now())

  checks LightTrapCheck[]

  @@unique([factoryId, trapNumber])
}

model LightTrapCheck {
  id               String    @id @default(cuid())
  trapId           String
  trap             LightTrap @relation(fields: [trapId], references: [id], onDelete: Cascade)
  date             DateTime
  fliesCount       Int       @default(0)
  beesCount        Int       @default(0)
  waspsCount       Int       @default(0)
  mothsCount       Int       @default(0)
  mosquitoesCount  Int       @default(0)
  otherCount       Int       @default(0)
  stickyPadChanged Boolean   @default(false)
  checkedByName    String?
  notes            String?
  createdAt        DateTime  @default(now())

  @@unique([trapId, date])
}

enum RodentTrapType {
  BAIT_STATION
  GLUE_TRAP
}

enum RodentTrapStatus {
  INTACT
  WET
  SPOILED
  EATEN_TRACE
  MISSING
  BROKEN
  DISPLACED
  LIVE_RODENT
  DEAD_RODENT
  GOOD
  NOT_GOOD
  OTHER
}

model RodentTrap {
  id         String         @id @default(cuid())
  factoryId  String
  factory    Factory        @relation(fields: [factoryId], references: [id])
  trapNumber String
  trapType   RodentTrapType
  location   String?
  createdAt  DateTime       @default(now())

  checks RodentTrapCheck[]

  @@unique([factoryId, trapNumber, trapType])
}

model RodentTrapCheck {
  id            String           @id @default(cuid())
  trapId        String
  trap          RodentTrap       @relation(fields: [trapId], references: [id], onDelete: Cascade)
  date          DateTime
  status        RodentTrapStatus
  checkedByName String?
  notes         String?
  createdAt     DateTime         @default(now())

  @@unique([trapId, date])
}

// The approved pesticide/crop-protection reference program (PPPL) per growth
// stage -- what's authorized to spray against which pest, at what dose/PHI/
// MRL, distinct from FieldSprayRecord (which logs what was actually applied
// in the field). Revised season to season by the grower, hence a real
// editable model rather than static content.
enum CropProtectionGrowthStage {
  MOTHER_PLANTS
  NURSERY
  OPEN_FIELD
  UNIDO_GREENHOUSE
}

enum CropProtectionTreatmentMethod {
  SPRAYING
  INJECTION
  DUSTING
  FUMIGATION
  STERILIZATION
  DISTRIBUTION_OF_NATURAL_ENEMIES
  // Open Field's soil treatments (nematicides, etc.) applied via the
  // irrigation drip system rather than sprayed or injected directly.
  THROUGH_DRIP_LINES
}

enum CropProtectionCategory {
  BIOLOGICAL
  CHEMICAL
  NATURAL_ENEMIES
}

model CropProtectionPlan {
  id                   String                    @id @default(cuid())
  growthStage          CropProtectionGrowthStage
  farmName             String?
  exportSeason         String?
  cropName             String?
  variety              String?
  gradeClassifications String?
  developedBy          String?
  revisedBy            String?
  approvedBy           String?
  versionDate          DateTime
  // False for a version superseded by a newer one for the same growth stage.
  isCanonical          Boolean                   @default(true)
  // True for Open Field until the grower supplies this year's real data --
  // renders as an explicit empty state rather than stale/unconfirmed rows.
  isSkeleton           Boolean                   @default(false)
  // Fairtrade Hazardous Materials List classification footer -- present on
  // the Mother Plants plan only.
  hazardListNote       String?
  notes                String?
  entries              CropProtectionEntry[]
  isTestData           Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([growthStage])
}

// Numeric-looking fields (dose, PHI, re-entry, MRL) are String, not Float/Int,
// because the source documents mix numbers, ranges ("100 to 600L"), combined
// active-ingredient values ("0.1+0.01"), and "NA" -- the same reasoning
// already used for ClientSpec's tolerance fields.
model CropProtectionEntry {
  id                                String                          @id @default(cuid())
  planId                            String
  plan                              CropProtectionPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  targetPestOrDisease               String
  pestStage                        String?
  economicInjuryThreshold           String?
  plantGrowthStage                  String?
  treatmentMethod                   CropProtectionTreatmentMethod?
  category                          CropProtectionCategory?
  formulationCode                   String?
  activeIngredient                  String?
  commercialProductName             String
  registrationNumber                String?
  manufacturer                      String?
  activeIngredientConcentrationPct  String?
  dosePer100L                       String?
  waterVolumePerFeddan              String?
  dosePerFeddan                     String?
  proposedPhiDays                   String?
  reEntryPeriodHours                String?
  applicationTimeWindow             String?
  maxTreatmentsPerSeason            String?
  strictestMrlLimitMgKg             String?
  euArfdMgKg                        String?
  // Per-product Fairtrade Hazardous Materials List classification (Red/
  // Orange/etc) -- distinct from CropProtectionPlan.hazardListNote, which is
  // just the plan-level footer explaining what the classification means.
  fairtradeHazardClass              String?
  // Orange List sub-conditions (e.g. "not within a month of flowering") --
  // only meaningful when fairtradeHazardClass is an Orange List code.
  fairtradeSpecificConditions       String?
  // "On label" / a phase-out date / a source-specific note -- mixed format
  // in the source documents, same reasoning as the other String? fields.
  offLabelDate                      String?
  conditionsOfUse                   String?
  // The 3 Nursery product names logged with no dosing data yet -- under
  // review, not yet an approved entry.
  isPending                         Boolean                         @default(false)
  notes                             String?
  isTestData                        Boolean                         @default(false)
  createdAt                         DateTime                        @default(now())
  updatedAt                         DateTime                        @updatedAt

  @@index([planId])
  @@index([targetPestOrDisease])
}

// A visitor to the factory (client, supplier, official, or anyone else) --
// most visits are just a log entry with optional feedback. When a visitor is
// a client auditor, isAudit is set and detailed findings can be attached.
model FactoryVisit {
  id               String    @id @default(cuid())
  factoryId        String
  factory          Factory   @relation(fields: [factoryId], references: [id])
  date             DateTime
  // Multiple visitors can arrive together under one company -- one visit
  // record, one sign-off, several names.
  visitorNames     String[] @default([])
  organization     String?
  purpose          String
  isAudit          Boolean   @default(false)
  generalFeedback  String?
  recordedByUserId String?
  recordedByUser   User?     @relation(fields: [recordedByUserId], references: [id])
  findings         ClientAuditFinding[]
  isTestData       Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([factoryId])
  @@index([date])
}

enum AuditFindingCategory {
  STRENGTH
  ISSUE
}

enum AuditFindingSeverity {
  MINOR
  MAJOR
  CRITICAL
}

model ClientAuditFinding {
  id          String       @id @default(cuid())
  visitId     String
  visit       FactoryVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  category    AuditFindingCategory
  area        String?
  description String
  // ISSUE only -- a STRENGTH has nothing to rate the severity of.
  severity    AuditFindingSeverity?

  // An ISSUE finding can be escalated into the existing Non-Conformance CAPA
  // workflow rather than tracking a second, parallel corrective-action
  // process just for audit findings.
  linkedNonConformanceReportId String?
  linkedNonConformanceReport   NonConformanceReport? @relation(fields: [linkedNonConformanceReportId], references: [id])

  photos     ClientAuditFindingPhoto[]
  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([visitId])
}

model ClientAuditFindingPhoto {
  id               String             @id @default(cuid())
  findingId        String
  finding          ClientAuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  fileName         String
  originalName     String
  caption          String?
  uploadedByUserId String?
  uploadedBy       User?              @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime           @default(now())
}

// The 9 granular floor-supervisor positions the owner has written protocols
// for -- distinct from the app's own Role/Station enums, which are login
// permission levels, not physical job titles.
enum SupervisorProtocolRole {
  COLD_STORAGE_LOADING
  RAW_MATERIAL_FEED
  GENERAL_ALL_SUPERVISORS
  OPERATIONS_MANAGER
  LINE_SORTING
  HEALTH_AND_SAFETY
  FACTORY_MANAGER
  RECEIVING
  PACKING
}

// A supervisor formally acknowledging they've read their role's protocol --
// attendeeName is free text (not a User relation) since most floor
// supervisors have no app login, same reasoning as StaffTrainingRecord.
model ProtocolAcknowledgment {
  id               String                 @id @default(cuid())
  role             SupervisorProtocolRole
  attendeeName     String
  jobTitle         String?
  acknowledgedDate DateTime
  notes            String?
  recordedByUserId String?
  recordedByUser   User?    @relation(fields: [recordedByUserId], references: [id])
  isTestData       Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([role])
  @@index([attendeeName])
}

// The factory's organizational chart -- prepared fresh every season per the
// Factory Manager's own protocol ("prepare the organizational chart with
// names and headcounts"). A real editable model, not static content, since
// names/headcounts change without a code deploy. Ships as an empty skeleton
// until the owner supplies real positions.
model OrgPosition {
  id            String        @id @default(cuid())
  title         String
  department    String?
  reportsToId   String?
  reportsTo     OrgPosition?  @relation("OrgReporting", fields: [reportsToId], references: [id])
  directReports OrgPosition[] @relation("OrgReporting")
  headcount     Int           @default(0)
  // Null = vacant/placeholder position, filled in as real names arrive.
  personName    String?
  notes         String?
  sortOrder     Int           @default(0)
  isTestData    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Facility-level certifications (BRCGS, SMETA, FDA, Kosher, etc.) -- tracked
// so renewal can happen well before expiry, via the same expiring-soon alert
// pattern already used for GlobalG.A.P. (see CompanySettings.globalGapExpiry
// and checkGlobalGapExpiry in src/lib/alerts.ts), kept separate since that
// one is a farm-level accreditation rather than a facility certification.
model Certification {
  id         String   @id @default(cuid())
  name       String
  certNumber String?
  validTo    DateTime
  notes      String?
  isTestData Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum HaccpHazardCategory {
  BIOLOGICAL
  CHEMICAL
  PHYSICAL
  ALLERGEN
  FRAUD
  SECURITY
  RADIOLOGICAL
}

// The real hazard-analysis table backing haccp-flow-diagram's 23 process
// steps (Magrabi Agriculture IQF Strawberry HACCP Study, Issue 01.2, updated
// 08/03/2026) -- one row per hazard category assessed at each step,
// including the ones the study found "not applicable" (hazardArabic/
// controlsArabic null), since documenting that every category was
// considered is itself part of a real HACCP study. hazardArabic/
// controlsArabic are transcribed verbatim in the source's own Arabic, not
// translated -- this is a legal/regulatory food-safety document, and
// translating it risks subtly changing a real hazard or control statement.
// isCcp is true only for step 016 (Metal Detection), the study's one
// Critical Control Point -- matches haccp-flow-diagram's existing CCP 01.
model HaccpHazard {
  id                String              @id @default(cuid())
  processStepNumber String
  category          HaccpHazardCategory
  hazardArabic      String?
  controlsArabic    String?
  probability       Int?
  severity          Int?
  result            Int?
  resultLabel       String?
  isCcp             Boolean             @default(false)
  sortOrder         Int
  createdAt         DateTime            @default(now())

  @@index([processStepNumber])
}

